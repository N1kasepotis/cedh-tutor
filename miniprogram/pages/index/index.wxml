<view class="page home">
  <view class="home-content">
    <view class="home-hero" style="padding-top: {{homeNavClearancePx}}px;">
      <view class="home-format-notes" aria-label="Commander format annotations">
        <text class="home-format-note">RULE 903 DEFINES EDH AS MULTIPLAYER COMMANDER</text>
        <text class="home-format-note home-format-note-next">EVERY DECK PLAYS 100 SINGLETON CARDS</text>
        <text class="home-format-note home-format-note-next">EVERY PLAYER STARTS THE GAME AT 40 LIFE</text>
        <text class="home-format-note home-format-para">CEDH PLAYS THE SAME RULES AT FULL POWER</text>
        <text class="home-format-note home-format-note-next">PODS OF FOUR RACE ON FAST MANA AND TUTORS</text>
        <text class="home-format-note home-format-note-next">MOST GAMES END BETWEEN TURN 2 AND TURN 6</text>
        <text class="home-format-note home-format-para">EVERY SEAT PLAYS TO WIN AND NO ONE APOLOGIZES</text>
        <view class="home-redaction" aria-hidden="true"></view>
        <text class="home-format-note home-format-note-next">ALLIANCES FOLLOW THREAT NOT FRIENDSHIP</text>
        <text class="home-format-note home-format-note-next">PROXIES ARE WELCOME AT MOST TABLES</text>
      </view>

      <view class="home-title-block">
        <text class="home-title-brand">cEDH Tutor</text>
        <text class="home-title-zh">竞技指挥官导师</text>
      </view>
    </view>

    <view class="home-actions" aria-role="navigation" aria-label="主要功能">
      <view class="home-button home-button-edhti home-button-tall home-button-heavy {{glitchIndex === 0 ? 'is-glitch' : ''}}" aria-role="button" aria-label="人格测试" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goEdhti">
        <text class="home-button-index home-button-index-xl">01</text>
        <view class="home-button-text">
          <text class="home-button-zh">人格测试</text>
          <text class="home-button-en">EDHTI PROFILE</text>
        </view>
      </view>

      <view class="home-button home-button-match home-button-short home-button-shift {{glitchIndex === 1 ? 'is-glitch' : ''}}" aria-role="button" aria-label="火花觉醒，指挥官问卷" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goQuiz">
        <text class="home-button-index home-button-index-over">02</text>
        <view class="home-button-text">
          <text class="home-button-zh">火花觉醒</text>
          <text class="home-button-en">COMMANDER FINDER</text>
        </view>
      </view>

      <view class="home-rule-slash" aria-hidden="true">/////////////////////////////</view>

      <view class="home-button home-button-bracket {{glitchIndex === 2 ? 'is-glitch' : ''}}" aria-role="button" aria-label="强度分级" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goBracket">
        <text class="home-button-index home-button-index-xl">03</text>
        <view class="home-button-text">
          <text class="home-button-zh">强度分级</text>
          <text class="home-button-en">BRACKET ANALYSIS</text>
        </view>
      </view>

      <view class="home-button home-button-playtest home-button-short {{glitchIndex === 3 ? 'is-glitch' : ''}}" aria-role="button" aria-label="套牌试玩" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goPlaytest">
        <text class="home-button-index">04</text>
        <view class="home-button-text">
          <text class="home-button-zh home-button-zh-sm">套牌试玩</text>
          <text class="home-button-en">DECK SANDBOX</text>
        </view>
      </view>

      <view class="home-button home-button-life home-button-tall home-button-heavy {{glitchIndex === 4 ? 'is-glitch' : ''}}" aria-role="button" aria-label="血量记录" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goLifeTracker">
        <text class="home-button-index home-button-index-xxl">05</text>
        <view class="home-button-text">
          <text class="home-button-zh">血量记录</text>
          <text class="home-button-en">LIFE COUNTER</text>
        </view>
      </view>

      <view class="home-button home-button-random home-button-shift {{glitchIndex === 5 ? 'is-glitch' : ''}}" aria-role="button" aria-label="混沌工具" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goRandom">
        <text class="home-button-index home-button-index-over">06</text>
        <view class="home-button-text">
          <text class="home-button-zh">混沌工具</text>
          <text class="home-button-en">CHAOS TOOLKIT</text>
        </view>
      </view>

      <view class="home-button home-button-tracker {{glitchIndex === 6 ? 'is-glitch' : ''}}" aria-role="button" aria-label="我的主将" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="goTracker">
        <text class="home-button-index home-button-index-xl">07</text>
        <view class="home-button-text">
          <text class="home-button-zh">我的主将</text>
          <text class="home-button-en">COMMANDER LOG</text>
        </view>
      </view>

      <view class="home-button home-button-meta home-button-tall {{glitchIndex === 7 ? 'is-glitch' : ''}}" aria-role="button" aria-label="环境梯度，功能开发中" hover-class="home-index-active" hover-start-time="0" hover-stay-time="60" bindtap="showMetaComingSoon">
        <text class="home-button-index home-button-index-xl">08</text>
        <view class="home-button-text">
          <text class="home-button-zh">环境梯度</text>
          <text class="home-button-en">META TIER LIST</text>
        </view>
      </view>
    </view>

    <view class="home-colophon" aria-label="版次与授权信息">
      <text class="home-colophon-item">BY CPP123 + 345</text>
      <text class="home-colophon-item home-colophon-center">MIT LICENSE</text>
      <text class="home-colophon-item home-colophon-right">SCRYFALL API</text>
    </view>
  </view>

  <text class="home-edge-tagline" aria-hidden="true">PLAY TO WIN | PLAY FOR THE GAME</text>
</view>
