page {
  height: 100%;
  overflow: hidden;
  background: #D0F03C;
}

.home {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  padding: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  color: #0A0A0A;
  background: #D0F03C;
  font-family: "HomePixel", "Fusion Pixel 10px Monospaced SC", "Zpix", ui-monospace, monospace;
}

.home-content {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
}

.home-hero {
  box-sizing: border-box;
  display: flex;
  min-height: 0;
  flex: 0 0 45vh;
  flex-direction: column;
  padding-right: 24rpx;
  padding-bottom: 30rpx;
  padding-left: 20rpx;
  overflow: hidden;
}

/* 规则宣言：满墙涂鸦式压迫感——极密行距、整体轻微倾斜、贴边溢出，不再优雅留白 */
.home-format-notes {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-start;
  margin-right: -12rpx;
  transform: rotate(-1.3deg);
  transform-origin: left top;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
}

.home-format-note {
  display: block;
  max-width: 100%;
  color: rgba(0,0,0,0.35);
  font-size: 7px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.4px;
  line-height: 1.15;
  text-transform: uppercase;
  white-space: nowrap;
}

.home-format-note-next {
  margin-top: 3rpx;
}

.home-format-para {
  margin-top: 12rpx;
  color: #0A0A0A;
}

/* 审查/遮挡：实心黑条压在宣言里，像一条被涂掉的规则 */
.home-redaction {
  width: 180rpx;
  height: 12rpx;
  margin-top: 4rpx;
  margin-left: 40rpx;
  background: #0A0A0A;
}

.home-title-block {
  display: flex;
  min-width: 0;
  margin-top: auto;
  flex-direction: column;
  align-items: flex-start;
  overflow: visible;
}

.home-title-brand,
.home-title-zh {
  display: block;
  font-style: normal;
  font-weight: 400;
  white-space: nowrap;
}

/* 喊叫：超粗 grotesk 横向拉伸变形 + 倾斜；字号留边以保证品牌名在窄机型不被右缘裁掉 */
.home-title-brand {
  color: #FFFFFF;
  font-family: "cEDHDisplay", "Arial Black", Impact, "Avenir Next Condensed", "DIN Condensed", sans-serif;
  font-size: 48px;
  font-weight: 900;
  letter-spacing: -0.06em;
  line-height: 0.84;
  -webkit-font-smoothing: antialiased;
  -webkit-text-stroke: 0.6px #FFFFFF;
  transform: scaleX(1.18) skewX(-10deg);
  transform-origin: left center;
}

.home-title-zh {
  margin-top: 20rpx;
  color: #FFFFFF;
  font-size: 18px;
  letter-spacing: 5px;
  line-height: 1;
}

.home-actions {
  box-sizing: border-box;
  display: flex;
  min-height: 0;
  flex: 1 1 55%;
  flex-direction: column;
  border-top: 5px solid #0A0A0A;
}

/* 有意破坏：行高不等、部分偏移打破左对齐线、编号巨号压字、分割线粗暴混用 */
.home-button {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 0;
  flex: 1 1 0;
  align-items: center;
  padding: 0 24rpx 0 20rpx;
  overflow: visible;
  color: #0A0A0A;
  background: transparent;
  border: 0;
  border-bottom: 1px solid rgba(0,0,0,0.35);
  border-radius: 0;
  transition: color 60ms linear, background-color 60ms linear;
}

.home-button-tall {
  flex-grow: 1.45;
}

.home-button-short {
  flex-grow: 0.72;
}

.home-button-shift {
  padding-left: 64rpx;
}

.home-button-heavy {
  border-bottom: 5px solid #0A0A0A;
}

.home-button-index {
  display: block;
  flex: 0 0 auto;
  min-width: 84rpx;
  color: #0A0A0A;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 16px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
  line-height: 0.8;
}

.home-button-index-xl {
  font-size: 28px;
  min-width: 96rpx;
}

.home-button-index-xxl {
  font-size: 38px;
  min-width: 108rpx;
}

/* 偏移行的编号负位移，压到左缘外并叠上文字 */
.home-button-index-over {
  font-size: 24px;
  min-width: 56rpx;
  margin-left: -40rpx;
}

.home-button-text {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  align-items: baseline;
  justify-content: space-between;
  overflow: hidden;
  white-space: nowrap;
}

.home-button-zh {
  display: block;
  flex: 0 0 auto;
  color: #0A0A0A;
  font-size: 20px;
  font-weight: 400;
  letter-spacing: 3px;
  line-height: 1;
}

.home-button-zh-sm {
  font-size: 16px;
  letter-spacing: 2px;
}

.home-button-en {
  display: block;
  min-width: 0;
  margin-left: 20rpx;
  flex: 0 1 auto;
  overflow: hidden;
  color: rgba(0,0,0,0.55);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-transform: uppercase;
}

/* 粗暴分割：字符 /// 一整行当分隔线 */
.home-rule-slash {
  flex: 0 0 auto;
  padding: 1rpx 20rpx;
  overflow: hidden;
  color: #0A0A0A;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1;
  white-space: nowrap;
}

/* 事故色：随机一行"故障"成电光蓝底黑字，像一个 glitch/错误 */
.home-button.is-glitch {
  background: #00B3FF;
}

.home-button.is-glitch .home-button-index,
.home-button.is-glitch .home-button-zh,
.home-button.is-glitch .home-button-en {
  color: #0A0A0A;
}

/* 暴力按压：整块反相为黑底 + 电光蓝字，而非温柔缩放 */
.home-index-active {
  background: #0A0A0A;
}

.home-index-active .home-button-index,
.home-index-active .home-button-zh,
.home-index-active .home-button-en {
  color: #00B3FF;
}

/* 版权：极小近乎隐形的 fine print */
.home-colophon {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  flex: 0 0 auto;
  align-items: baseline;
  padding: 8rpx 20rpx 6rpx;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
}

.home-colophon-item {
  display: block;
  color: rgba(0,0,0,0.35);
  font-size: 6px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5px;
  line-height: 1.3;
  text-transform: uppercase;
  white-space: nowrap;
}

.home-colophon-center {
  text-align: center;
}

.home-colophon-right {
  text-align: right;
}

/* 侧栏格言：竖排贴右缘，从"底部居中"移到"页面侧脊" */
.home-edge-tagline {
  position: fixed;
  top: 0;
  bottom: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding-right: 3rpx;
  writing-mode: vertical-rl;
  text-orientation: sideways;
  color: rgba(0,0,0,0.35);
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .home-title-brand {
    font-size: 42px;
  }

  .home-title-zh {
    font-size: 16px;
  }

  .home-button-en {
    margin-left: 12rpx;
    font-size: 8px;
  }
}

@media (max-height: 700px) {
  .home-hero {
    flex-basis: 40vh;
    padding-bottom: 22rpx;
  }

  .home-format-note-next {
    margin-top: 2rpx;
  }

  .home-format-para {
    margin-top: 8rpx;
  }

  .home-title-brand {
    font-size: 42px;
  }

  .home-title-zh {
    margin-top: 14rpx;
    font-size: 15px;
  }
}

@media (max-height: 600px) {
  .home-hero {
    flex-basis: 40vh;
  }

  .home-title-brand {
    font-size: 38px;
  }

  .home-title-zh {
    margin-top: 10rpx;
    font-size: 13px;
  }

  .home-format-note {
    font-size: 6px;
    letter-spacing: 0.2px;
    line-height: 1.1;
  }

  .home-colophon-item {
    font-size: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-button {
    transition: none;
  }
}
