page {
  height: 100%;
  overflow: hidden;
  background: #D0F03C;
}

.home {
  position: relative; /* 背景线场按它定位，不能依赖默认的初始包含块 */
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  padding: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  color: #0A0A0A;
  background: #D0F03C;
  font-family: "HomePixel", "Fusion Pixel 10px Monospaced SC", "Zpix", ui-monospace, monospace;
}

/* ===== 背景：Voronoi 线场 =====
   选它是因为首页的约束把别的路都堵死了：border-radius 锁死为唯一一条 0，圆形画不了；
   渐变、背景图、裁切路径也全在禁用之列（测试连注释一起扫，所以这里只能中文描述）。
   只剩「直线段 + transform + 既有色板」，而 Voronoi 的胞元边恰好全是直线段，
   又天然不规则、没有可重复的单元。线段坐标由 scripts/build-home-voronoi.js 构建期算好。

   容器取正方形（边长按视口宽算）：线段长度是在 100×100 的方形坐标系里算的，
   若容器非正方形，百分比宽度会被拉伸成错误长度。做成正方形并允许溢出，
   胞元自然被 .home 的 overflow:hidden 裁掉，读起来像「更大结构的一角」而不是一张完整图案。 */
.home-field {
  position: absolute;
  top: -30vw;
  right: -25vw;
  width: 120vw;
  height: 120vw;
  opacity: 0.55;
  pointer-events: none;
  animation: home-field-turn 71s ease-in-out infinite alternate;
}

.home-field-drift {
  width: 100%;
  height: 100%;
  animation: home-field-drift 97s ease-in-out infinite alternate;
}

.home-field-line {
  position: absolute;
  height: 1px;
  background: rgba(0,0,0,0.35);
  transform-origin: left center;
}

/* 结点：Black Orbit 母题里的 junction spark。全页唯一的事故色在这里只用两枚 2px 方点，
   小到不与 glitch 行抢注意力，但让线场有「交汇处」而不只是一堆线。 */
.home-field-node {
  position: absolute;
  width: 2px;
  height: 2px;
  margin: -1px 0 0 -1px;
  background: #00B3FF;
}

/* 两层动效的周期刻意取互质的 71s 与 97s，且都是 alternate（实际周期 142s 与 194s）。
   两者最小公倍数约 3.8 小时，合成运动在一次使用里永远走不完一轮——这是不靠每帧重算
   就能得到「不规律」的办法。真正的 Voronoi 动画（种子移动、胞元重算）在移动端并不简单：
   要每帧重算 38 条线再 setData 过桥，正是该避免的做法；而这里两个 transform 走合成器，
   不碰数据层。 */
@keyframes home-field-turn {
  from { transform: rotate(-2.4deg); }
  to { transform: rotate(2.4deg); }
}

@keyframes home-field-drift {
  from { transform: translate3d(-1.6%, 1.1%, 0); }
  to { transform: translate3d(1.6%, -1.1%, 0); }
}

.home-content {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
}

.home-hero {
  box-sizing: border-box;
  display: flex;
  min-height: 0;
  flex: 0 0 45vh;
  flex-direction: column;
  padding-right: 24rpx;
  padding-bottom: 30rpx;
  padding-left: 20rpx;
  overflow: hidden;
}

/* 规则宣言：满墙涂鸦式压迫感——极密行距、整体轻微倾斜、贴边溢出，不再优雅留白 */
.home-format-notes {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-start;
  margin-right: -12rpx;
  transform: rotate(-1.3deg);
  transform-origin: left top;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
}

.home-format-note {
  display: block;
  max-width: 100%;
  color: rgba(0,0,0,0.35);
  font-size: 7px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.4px;
  line-height: 1.15;
  text-transform: uppercase;
  white-space: nowrap;
}

.home-format-note-next {
  margin-top: 3rpx;
}

.home-format-para {
  margin-top: 12rpx;
  color: #0A0A0A;
}

/* 审查/遮挡：每次进页随机涂黑一整行——把那一行自己的文字盒染成实心黑、字色同底而隐去。
   黑条即文字盒本身，故与文字天然等宽等高、必定盖住；不做像素定位，字体回退与屏高断点
   都不会让它悬空。左右各外扩 6rpx 作马克笔涂抹感，用负 margin 抵消保持左缘对齐。 */
.home-format-note.is-redacted {
  padding: 0 6rpx;
  margin-left: -6rpx;
  color: #0A0A0A;
  background: #0A0A0A;
}

.home-title-block {
  display: flex;
  min-width: 0;
  margin-top: auto;
  flex-direction: column;
  align-items: flex-start;
  overflow: visible;
}

.home-title-brand,
.home-title-zh {
  display: block;
  font-style: normal;
  font-weight: 400;
  white-space: nowrap;
}

/* 喊叫：超粗 grotesk 横向拉伸变形 + 倾斜；字号留边以保证品牌名在窄机型不被右缘裁掉 */
.home-title-brand {
  color: #FFFFFF;
  font-family: "cEDHDisplay", "Arial Black", Impact, "Avenir Next Condensed", "DIN Condensed", sans-serif;
  font-size: 48px;
  font-weight: 900;
  letter-spacing: -0.06em;
  line-height: 0.84;
  -webkit-font-smoothing: antialiased;
  -webkit-text-stroke: 0.6px #FFFFFF;
  transform: scaleX(1.18) skewX(-10deg);
  transform-origin: left center;
}

.home-title-zh {
  margin-top: 20rpx;
  color: #FFFFFF;
  font-size: 18px;
  letter-spacing: 5px;
  line-height: 1;
}

.home-actions {
  box-sizing: border-box;
  display: flex;
  min-height: 0;
  flex: 1 1 55%;
  flex-direction: column;
  border-top: 5px solid #0A0A0A;
}

/* 有意破坏：行高不等、部分偏移打破左对齐线、编号巨号压字、分割线粗暴混用 */
.home-button {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 0;
  flex: 1 1 0;
  align-items: center;
  padding: 0 40rpx 0 20rpx;
  overflow: visible;
  color: #0A0A0A;
  background: transparent;
  border: 0;
  border-bottom: 1px solid rgba(0,0,0,0.35);
  border-radius: 0;
  transition: color 60ms linear, background-color 60ms linear;
}

.home-button-tall {
  flex-grow: 1.45;
}

.home-button-short {
  flex-grow: 0.72;
}

.home-button-shift {
  padding-left: 64rpx;
}

.home-button-heavy {
  border-bottom: 5px solid #0A0A0A;
}

.home-button-index {
  display: block;
  flex: 0 0 auto;
  min-width: 84rpx;
  color: #0A0A0A;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 16px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
  line-height: 0.8;
}

.home-button-index-xl {
  font-size: 28px;
  min-width: 96rpx;
}

.home-button-index-xxl {
  font-size: 38px;
  min-width: 108rpx;
}

/* 偏移行的编号负位移，压到左缘外并叠上文字 */
.home-button-index-over {
  font-size: 24px;
  min-width: 56rpx;
  margin-left: -40rpx;
}

/* 编号的四种字面「声音」：不按行号随机换字体，而是跟着每行本来就有的角色走
   （heavy / shift / plain / short），让差异读起来是系统而不是杂音。
   全部复用已内嵌的两套字体与既有色板，不新增资源、不引入会静默失败的描边。 */

/* 喊叫（heavy 行 01/05）：与 cEDH Tutor 字标同源的超粗，字标喊、编号也喊 */
.home-index-shout {
  font-family: "cEDHDisplay", "Arial Black", Impact, "Avenir Next Condensed", "DIN Condensed", sans-serif;
  font-weight: 900;
  letter-spacing: -0.04em;
}

/* 涂黑（shift 行 02/06）：这两行本来就负位移压在文字上，改成实心黑块反白，
   与注释墙的「审查涂黑」同一语汇，压得更狠 */
.home-index-redacted {
  padding: 2rpx 10rpx;
  /* 黑块比字形宽出 10rpx，会吃掉原本靠字形侧边距留出的间隙、顶到中文；
     这里把间隙还回来，让实心块与中文之间仍有可呼吸的留白 */
  margin-right: 18rpx;
  color: #D0F03C;
  background: #0A0A0A;
  letter-spacing: 0.04em;
}

/* 点阵（plain 行 03/07）：与下方点阵中文目录同族。对比来自「点阵 vs 实心」的肌理，
   不是靠缩小，所以仍保持巨号；30px 是 10px 网格的整数倍，放大后依然锐利 */
.home-index-whisper {
  font-family: "HomePixel", "Fusion Pixel 10px Monospaced SC", "Zpix", ui-monospace, monospace;
  font-size: 30px;
  font-weight: 400;
  letter-spacing: 0.08em;
}

/* 变形（short 行 04）：横向拉伸，呼应被 scaleX 拉变形的字标 */
.home-index-stretch {
  transform: scaleX(1.5);
  transform-origin: left center;
  letter-spacing: -0.02em;
}

.home-button-text {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  align-items: baseline;
  justify-content: space-between;
  overflow: hidden;
  white-space: nowrap;
}

.home-button-zh {
  display: block;
  flex: 0 0 auto;
  color: #0A0A0A;
  font-size: 20px;
  font-weight: 400;
  letter-spacing: 3px;
  line-height: 1;
}

.home-button-zh-sm {
  font-size: 16px;
  letter-spacing: 2px;
}

.home-button-en {
  display: block;
  min-width: 0;
  margin-left: 20rpx;
  flex: 0 1 auto;
  overflow: hidden;
  /* 副标题是这一行里唯一说明「点进去会发生什么」的功能文本，不按装饰文本的标准压小压淡：
     10px + 0.7 alpha 在 #D0F03C 上约 7.5:1，过 WCAG AA 正文 4.5:1（原 9px / 0.55 只有约 4.46:1） */
  color: rgba(0,0,0,0.7);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-transform: uppercase;
}

/* NEW 角标：用事故色电光蓝——全页唯一的第五色，只在 glitch 行和按压反相时出现，
   因此它一现身就是全页最扎眼的东西，不需要动效也够抢眼。
   斜切 -12deg 呼应被 skewX 拉变形的 cEDH Tutor 字标，不是随便贴一个圆角标签。 */
.home-button-flag {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 3px 8px;
  color: #0A0A0A;
  background: #00B3FF;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  line-height: 1.2;
  transform: skewX(-12deg);
  white-space: nowrap;
}

/* 该行被随机 glitch 命中时整行已是电光蓝底，角标必须反相，
   否则蓝底蓝块直接糊成一片（与涂黑编号同一类坑） */
.home-button.is-glitch .home-button-flag {
  color: #00B3FF;
  background: #0A0A0A;
}

/* 粗暴分割：字符 /// 一整行当分隔线 */
.home-rule-slash {
  flex: 0 0 auto;
  padding: 1rpx 20rpx;
  overflow: hidden;
  color: #0A0A0A;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1;
  white-space: nowrap;
}

/* 事故色：随机一行"故障"成电光蓝底黑字，像一个 glitch/错误 */
.home-button.is-glitch {
  background: #00B3FF;
}

.home-button.is-glitch .home-button-index,
.home-button.is-glitch .home-button-zh,
.home-button.is-glitch .home-button-en {
  color: #0A0A0A;
}

/* 涂黑编号在 glitch 行要单独反相：该行整行已是电光蓝底 + 纯黑字，
   而这枚编号自带纯黑块，沿用黑字会变成黑底黑字直接消失 */
.home-button.is-glitch .home-index-redacted {
  color: #00B3FF;
}

/* 暴力按压：整块反相为黑底 + 电光蓝字，而非温柔缩放 */
.home-index-active {
  background: #0A0A0A;
}

.home-index-active .home-button-index,
.home-index-active .home-button-zh,
.home-index-active .home-button-en {
  color: #00B3FF;
}

/* 版权：极小近乎隐形的 fine print；左右加大内缩 + 安全区，避免贴边被屏幕圆角吞掉 */
.home-colophon {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  flex: 0 0 auto;
  align-items: baseline;
  padding: 10rpx 48rpx 12rpx;
  padding-right: calc(48rpx + constant(safe-area-inset-right));
  padding-right: calc(48rpx + env(safe-area-inset-right));
  padding-left: calc(48rpx + constant(safe-area-inset-left));
  padding-left: calc(48rpx + env(safe-area-inset-left));
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
}

.home-colophon-item {
  display: block;
  color: rgba(0,0,0,0.35);
  font-size: 6px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5px;
  line-height: 1.3;
  text-transform: uppercase;
  white-space: nowrap;
}

.home-colophon-center {
  text-align: center;
}

.home-colophon-right {
  text-align: right;
}

/* 侧栏格言：竖排贴右侧脊；离右缘留出安全区、上下留白，避免被屏幕圆角/刘海吞掉 */
.home-edge-tagline {
  position: fixed;
  top: 0;
  bottom: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding-top: 60rpx;
  padding-bottom: 60rpx;
  padding-right: 14rpx;
  padding-right: calc(14rpx + constant(safe-area-inset-right));
  padding-right: calc(14rpx + env(safe-area-inset-right));
  writing-mode: vertical-rl;
  text-orientation: sideways;
  color: rgba(0,0,0,0.35);
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .home-title-brand {
    font-size: 42px;
  }

  .home-title-zh {
    font-size: 16px;
  }

  /* 窄屏只收紧间距，不再把功能文本降到 8px——挤版面该让装饰让路，不该让说明让路 */
  .home-button-en {
    margin-left: 12rpx;
    letter-spacing: 1px;
  }
}

@media (max-height: 700px) {
  .home-hero {
    flex-basis: 40vh;
    padding-bottom: 22rpx;
  }

  .home-format-note-next {
    margin-top: 2rpx;
  }

  .home-format-para {
    margin-top: 8rpx;
  }

  .home-title-brand {
    font-size: 42px;
  }

  .home-title-zh {
    margin-top: 14rpx;
    font-size: 15px;
  }
}

@media (max-height: 600px) {
  .home-hero {
    flex-basis: 40vh;
  }

  .home-title-brand {
    font-size: 38px;
  }

  .home-title-zh {
    margin-top: 10rpx;
    font-size: 13px;
  }

  .home-format-note {
    font-size: 6px;
    letter-spacing: 0.2px;
    line-height: 1.1;
  }

  .home-colophon-item {
    font-size: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-button {
    transition: none;
  }

  /* 线场停在中位，图形本身仍在，只是不再漂移 */
  .home-field,
  .home-field-drift {
    animation: none;
  }
}
