page {
  height: 100%;
  overflow: hidden;
  background: #D0F03C;
}

.home {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  padding: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  color: #FFFFFF;
  background: #D0F03C;
  font-family: "HomePixel", "Fusion Pixel 10px Monospaced SC", "Zpix", ui-monospace, monospace;
}

.home-content {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
}

.home-hero {
  box-sizing: border-box;
  display: flex;
  min-height: 0;
  flex: 0 0 45vh;
  flex-direction: column;
  padding-right: 40rpx;
  padding-bottom: 48rpx;
  padding-left: 40rpx;
  overflow: hidden;
}

/* 底部中置格言：坐落 credits 之上、居中，作为全页 cEDH 精神题词。普通无衬线字体、加粗、无投影。
   flex:0 0 auto 只占自身高度，垂直空间由上方 home-actions（flex 伸缩）吸收，避免矮屏溢出。 */
.home-epigraph {
  box-sizing: border-box;
  display: block;
  width: 100%;
  flex: 0 0 auto;
  padding: 16rpx 40rpx 0;
  color: rgba(0,0,0,0.55);
  font-family: -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 7px;
  font-weight: 400;
  letter-spacing: 0.7px;
  line-height: 1.35;
  text-align: center;
  text-transform: uppercase;
}

/* 工业注释风小字：完整句子成段，只用字母数字与空格，无冒号斜杠句号 */
.home-format-notes {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
}

.home-format-note {
  display: block;
  max-width: 100%;
  color: rgba(0,0,0,0.35);
  font-size: 7px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.7px;
  line-height: 1.35;
  text-transform: uppercase;
  word-spacing: 1px;
}

.home-format-note-next {
  margin-top: 8rpx;
}

.home-format-para {
  margin-top: 28rpx;
}

.home-title-block {
  display: flex;
  min-width: 0;
  margin-top: auto;
  padding-right: 16rpx;
  flex-direction: column;
  align-items: flex-start;
}

.home-title-brand,
.home-title-zh {
  display: block;
  max-width: 100%;
  font-style: normal;
  font-weight: 400;
  white-space: nowrap;
}

.home-title-brand {
  color: #FFFFFF;
  font-family: "cEDHDisplay", "Arial Black", Impact, "Avenir Next Condensed", "DIN Condensed", sans-serif;
  font-size: 52px;
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 0.92;
  -webkit-font-smoothing: antialiased;
  -webkit-text-stroke: 0.5px #FFFFFF;
  transform: skewX(-8deg);
  transform-origin: left center;
}

.home-title-zh {
  margin-top: 24rpx;
  color: #FFFFFF;
  font-size: 18px;
  letter-spacing: 4px;
  line-height: 1;
}

.home-actions {
  box-sizing: border-box;
  display: flex;
  min-height: 0;
  flex: 1 1 55%;
  flex-direction: column;
  border-top: 1px solid rgba(0,0,0,0.35);
}

.home-button {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 0;
  flex: 1 1 0;
  align-items: center;
  padding: 0 40rpx;
  overflow: hidden;
  color: #FFFFFF;
  background: transparent;
  border: 0;
  border-bottom: 1px solid rgba(0,0,0,0.35);
  border-radius: 0;
  transition: color 60ms linear, background-color 60ms linear;
}

/* 信息性文字用 0.55 半透明黑（对荧光绿 ≈4.4:1）；装饰注释与分隔线保持 0.35 */
.home-button-index {
  display: block;
  width: 72rpx;
  flex: 0 0 72rpx;
  color: rgba(0,0,0,0.55);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 2px;
  line-height: 1;
}

.home-button-text {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  align-items: baseline;
  justify-content: space-between;
  overflow: hidden;
  white-space: nowrap;
}

/* 20px = 点阵字体 10px 网格的整数倍，真机渲染最锐利 */
.home-button-zh {
  display: block;
  flex: 0 0 auto;
  color: #FFFFFF;
  font-size: 20px;
  font-weight: 400;
  letter-spacing: 4px;
  line-height: 1;
}

.home-button-en {
  display: block;
  min-width: 0;
  margin-left: 24rpx;
  flex: 0 1 auto;
  overflow: hidden;
  color: rgba(0,0,0,0.55);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 2px;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-index-active {
  color: #D0F03C;
  background: #0A0A0A;
}

.home-index-active .home-button-index,
.home-index-active .home-button-zh,
.home-index-active .home-button-en {
  color: #D0F03C;
}

/* 版权行绝对对称：三列网格（1fr auto 1fr），中段严格居中、两端贴边 */
.home-colophon {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  flex: 0 0 auto;
  align-items: baseline;
  padding: 20rpx 40rpx 10rpx;
  font-family: "Courier New", Courier, "Nimbus Mono PS", ui-monospace, monospace;
}

.home-colophon-item {
  display: block;
  color: rgba(0,0,0,0.55);
  font-size: 8px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1px;
  line-height: 1.4;
  text-transform: uppercase;
  white-space: nowrap;
}

.home-colophon-center {
  text-align: center;
}

.home-colophon-right {
  text-align: right;
}

@media (max-width: 360px) {
  .home-hero,
  .home-button,
  .home-colophon {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }

  .home-title-brand {
    font-size: 46px;
  }

  .home-title-zh {
    font-size: 16px;
  }

  .home-button-index {
    width: 64rpx;
    flex-basis: 64rpx;
  }

  .home-button-en {
    margin-left: 16rpx;
    font-size: 9px;
  }

  .home-colophon-item {
    letter-spacing: 0.5px;
  }
}

@media (max-height: 700px) {
  .home-hero {
    flex-basis: 40vh;
    padding-bottom: 36rpx;
  }

  .home-format-note-next {
    margin-top: 5rpx;
  }

  .home-format-para {
    margin-top: 18rpx;
  }

  .home-title-brand {
    font-size: 42px;
  }

  .home-title-zh {
    margin-top: 18rpx;
    font-size: 15px;
  }
}

@media (max-height: 600px) {
  .home-hero {
    flex-basis: 40vh;
  }

  .home-title-brand {
    font-size: 38px;
  }

  .home-title-zh {
    margin-top: 12rpx;
    font-size: 13px;
  }

  .home-format-note {
    font-size: 6px;
    letter-spacing: 0.25px;
    line-height: 1.2;
  }

  .home-format-note-next {
    margin-top: 3rpx;
  }

  .home-colophon {
    padding-top: 8rpx;
  }

  .home-colophon-item {
    font-size: 7px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-button {
    transition: none;
  }
}
