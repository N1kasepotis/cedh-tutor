@import "../../styles/themes/dark-table.wxss";

.random-shell {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-6);
}

.random-panel {
  padding: var(--cedh-space-6) var(--cedh-space-5);
  background: var(--cedh-surface-raised);
}

/* 技术仪表段标题：等宽 tracked 微标签，数值才是英雄 */
.panel-title {
  color: var(--cedh-text-soft);
  font-family: var(--cedh-font-mono);
  font-size: var(--cedh-text-14);
  font-weight: 600;
  letter-spacing: 0.14em;
  line-height: 1.2;
  text-transform: uppercase;
}

.range-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 34rpx minmax(0, 1fr);
  align-items: center;
  gap: var(--cedh-space-2);
  margin-top: var(--cedh-space-5);
}

.random-panel > .range-row:first-child,
.random-panel > .roll-grid:first-child {
  margin-top: 0;
}

.range-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--cedh-space-4);
  color: var(--cedh-text);
  background: var(--cedh-input-glass);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
  font-size: var(--cedh-text-16);
  text-align: center;
}

.range-separator {
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  text-align: center;
}

.preset-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--cedh-space-2);
  margin-top: var(--cedh-space-3);
}

.preset-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 64rpx;
  color: var(--cedh-text-soft);
  background: var(--cedh-surface-muted);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-control-sm);
  font-size: var(--cedh-text-10);
  font-weight: 600;
  letter-spacing: 0.1em;
}

.number-result {
  margin: var(--cedh-space-6) 0 var(--cedh-space-4);
  color: var(--cedh-accent);
  font-family: var(--cedh-font-serif);
  font-size: 96rpx;
  font-weight: 400;
  letter-spacing: -0.04em;
  line-height: 0.95;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.random-button {
  min-height: 86rpx;
}

.roll-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-5);
}

.roll-cell {
  min-width: 0;
  padding: var(--cedh-space-4);
  background: var(--cedh-surface-muted);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
}

.roll-cell.winner {
  background: var(--cedh-accent-soft);
  border-color: var(--cedh-accent-line);
}

.roll-seat {
  color: rgba(var(--module-accent-rgb), 0.85);
  font-family: var(--cedh-font-mono);
  font-size: var(--cedh-text-10);
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.roll-value {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-text);
  font-family: var(--cedh-font-serif);
  font-size: 56rpx;
  font-weight: 400;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.roll-cell.winner .roll-value {
  color: var(--cedh-accent);
}

.roll-result {
  min-height: 58rpx;
  margin: var(--cedh-space-5) 0 var(--cedh-space-4);
  color: var(--cedh-text);
  font-size: var(--cedh-text-14);
  font-weight: 600;
  line-height: 1.45;
}

.roll-result.tie {
  color: var(--cedh-accent);
}

.sticker-panel {
  overflow: hidden;
}

.sticker-summary {
  margin-top: var(--cedh-space-5);
  padding: var(--cedh-space-5);
  background: var(--cedh-surface-muted);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
}

.sticker-power {
  color: var(--cedh-text);
  font-family: var(--cedh-font-serif);
  font-size: var(--cedh-text-18);
  font-weight: 400;
  letter-spacing: -0.025em;
  line-height: 1.15;
}

.sticker-source {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-accent);
  font-size: var(--cedh-text-11);
  line-height: 1.45;
}

.sticker-disclaimer {
  margin-top: var(--cedh-space-3);
  color: rgba(255, 254, 250, 0.38);
  font-size: var(--cedh-text-10);
  line-height: 1.45;
  text-align: left;
}

.sticker-actions {
  display: block;
  margin-top: var(--cedh-space-4);
}

.sticker-warning {
  margin-top: var(--cedh-space-3);
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-11);
}

.sticker-results {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-5);
  transition: opacity 220ms ease, transform 220ms ease;
}

@media (prefers-reduced-motion: reduce) {
  .sticker-results {
    transition: none;
  }
}

.sticker-results.drawing {
  opacity: 0.42;
  transform: translateY(8rpx);
}

.sticker-result-card {
  padding: var(--cedh-space-4);
  background: var(--cedh-surface);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
}

.sticker-sheet-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-12);
  font-weight: 650;
  line-height: 1.35;
}

.sticker-word-list {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-2);
  margin-top: var(--cedh-space-3);
}

.sticker-word {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cedh-space-3);
  min-height: 58rpx;
  padding: 0 var(--cedh-space-3);
  color: var(--cedh-text-soft);
  background: var(--cedh-surface-muted);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-pill);
}

.sticker-word.best {
  color: var(--cedh-accent);
  background: var(--cedh-accent-soft);
  border-color: var(--cedh-accent-line);
}

.sticker-word-text {
  min-width: 0;
  overflow: hidden;
  font-size: var(--cedh-text-12);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sticker-vowel-count {
  flex-shrink: 0;
  color: inherit;
  font-size: var(--cedh-text-12);
  font-weight: 700;
}

/* ===== 独立工具入口卡 ===== */
.tool-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cedh-space-4);
}

/* 子模块保留自身身份色，避免被混沌工具的紫粉主题吞没。 */
.tool-entry-cabbage {
  --tool-entry-rgb: 47, 167, 93;
  background: linear-gradient(135deg, rgba(var(--tool-entry-rgb), 0.14), var(--cedh-surface-raised) 58%);
  border-color: rgba(var(--tool-entry-rgb), 0.34);
}

.tool-entry-izzet {
  --tool-entry-rgb: 90, 169, 255;
  background: linear-gradient(135deg, rgba(var(--tool-entry-rgb), 0.14), var(--cedh-surface-raised) 58%);
  border-color: rgba(var(--tool-entry-rgb), 0.34);
}

.tool-entry-cabbage .tool-entry-title {
  color: #bce8c9;
}

.tool-entry-cabbage .tool-entry-arrow {
  color: #2fa75d;
}

.tool-entry-izzet .tool-entry-title {
  color: #cfe6ff;
}

.tool-entry-izzet .tool-entry-arrow {
  color: #5aa9ff;
}

.tool-entry-text {
  min-width: 0;
}

.tool-entry-title {
  color: var(--cedh-text);
  font-family: var(--cedh-font-serif);
  font-size: var(--cedh-text-20);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.tool-entry-sub {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.45;
}

.tool-entry-arrow {
  flex-shrink: 0;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-30);
  line-height: 1;
}
