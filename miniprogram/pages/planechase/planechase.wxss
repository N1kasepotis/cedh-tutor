@import "../../styles/themes/dark-table.wxss";

/* 与混沌工具共用背景、面板和按钮 token；这里只定义内容布局。 */
.session-title, .plane-name, .desk-title, .source-title, .meter-value { font-family: var(--cedh-font-serif); }
.section-kicker, .rule-label, .source-id, .reveal-index, .note-index, .cost-value { font-family: var(--cedh-font-mono); }
.planechase-page { padding-bottom: calc(176px + env(safe-area-inset-bottom)); color: var(--cedh-text); }
.tool-shell { max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--cedh-space-6); }
.session-header, .source-header, .console-heading, .turn-row, .inspect-header { display: flex; align-items: center; justify-content: space-between; gap: var(--cedh-space-3); }
.session-heading { min-width: 0; }
.session-title { font-size: 24px; font-weight: 400; line-height: 1.25; letter-spacing: -0.02em; }
.session-subtitle { margin-top: var(--cedh-space-2); color: var(--cedh-text-soft); font-size: 12px; line-height: 1.5; }
.setup-toggle { flex: 0 0 auto; }
.session-meter { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--cedh-space-3); padding: var(--cedh-space-5); background: var(--cedh-surface-raised); }
.meter-cell { display: flex; flex-direction: column; align-items: center; gap: var(--cedh-space-2); }
.meter-value { font-size: 28px; color: var(--cedh-accent-ink); line-height: 1; font-variant-numeric: tabular-nums; }
.meter-label { color: var(--cedh-text-soft); font-size: 12px; line-height: 1.4; }
.view-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--cedh-space-3); scroll-margin-top: 12px; }
.view-tab { min-width: 0; min-height: 44px; padding: 10px; margin: 0; display: flex; align-items: center; justify-content: center; gap: 8px; border: var(--cedh-hairline); border-radius: var(--cedh-radius-control-sm); background: var(--cedh-surface-muted); color: var(--cedh-text-soft); font-size: 14px; line-height: 1.5; }
.view-tab.is-active { color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); border-color: var(--cedh-accent-line); }
.tab-index, .tab-count { font-size: 11px; line-height: 22px; min-width: 22px; text-align: center; color: var(--cedh-text-soft); background: var(--cedh-surface-muted); border-radius: var(--cedh-radius-pill); }
.tab-count.has-pending { color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); }
.plane-list, .resolution-desk { display: flex; flex-direction: column; gap: var(--cedh-space-5); min-width: 0; }
.plane-card { overflow: hidden; background: var(--cedh-surface-raised); }
.plane-art { display: block; position: relative; width: 100%; margin: 0; height: 0; padding: 0 0 44.6%; border-radius: 0; background: var(--cedh-image-placeholder); overflow: hidden; }
.plane-art-main { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 1; background: var(--cedh-image-placeholder); }
.art-placeholder { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; justify-content: center; align-items: center; padding: var(--cedh-space-4); color: var(--cedh-text-soft); background: var(--cedh-image-placeholder); }
.placeholder-label { font-size: 12px; line-height: 1.5; }
.art-caption { position: absolute; right: 10px; bottom: 10px; z-index: 2; padding: 6px 10px; background: var(--cedh-overlay-glass); color: var(--cedh-text); border: var(--cedh-hairline); border-radius: var(--cedh-radius-pill); font-size: 12px; line-height: 1.5; }
.plane-text { padding: var(--cedh-space-5); display: flex; flex-direction: column; gap: var(--cedh-space-4); }
.plane-heading { display: flex; flex-direction: column; gap: var(--cedh-space-2); }
.plane-type { font-size: 12px; line-height: 1.6; color: var(--cedh-text-soft); }
.plane-name { font-size: 24px; font-weight: 400; line-height: 1.3; letter-spacing: -0.02em; overflow-wrap: anywhere; }
.body-copy { font-size: 14px; line-height: 1.8; color: var(--cedh-text); overflow-wrap: anywhere; }
.muted-copy { color: var(--cedh-text-soft); }
.rule-section { display: flex; flex-direction: column; gap: var(--cedh-space-3); }
.rule-label, .section-kicker { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; line-height: 1.5; color: var(--cedh-text-soft); }
.chaos-section { padding: var(--cedh-space-4); background: var(--cedh-accent-soft); border: 1rpx solid var(--cedh-accent-line); border-radius: var(--cedh-radius-2); display: flex; flex-direction: column; gap: var(--cedh-space-3); }
.chaos-label { display: flex; align-items: center; gap: 6px; color: var(--cedh-accent-ink); }
.chaos-symbol { font-size: 18px; line-height: 1; }
.work-panel, .notice-panel { padding: var(--cedh-space-5); display: flex; flex-direction: column; gap: var(--cedh-space-3); }
.notice-panel, .error-panel { border-color: var(--cedh-accent-line); }
.error-panel .section-kicker { color: var(--cedh-accent-ink); }
.panel-heading { font-size: 15px; font-weight: 600; line-height: 1.5; }
.action-row, .count-row { display: flex; flex-wrap: wrap; gap: 8px; }
.pc-button { display: flex; justify-content: center; align-items: center; min-height: 44px; margin: 0; padding: 10px 12px; font-size: 13px; line-height: 1.5; color: var(--cedh-text-soft); background: var(--cedh-input-glass); border: var(--cedh-hairline); border-radius: var(--cedh-radius-control-sm); transition: opacity 220ms ease; }
.accent-button, .count-chip.is-selected, .setup-toggle.is-selected { color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); border-color: var(--cedh-accent-line); }
.count-chip { flex: 1; min-width: 44px; }
.setup-divider { height: 1rpx; background: var(--cedh-line); margin: var(--cedh-space-2) 0; }
.modifier-strip { display: flex; gap: var(--cedh-space-3); padding: var(--cedh-space-4); background: var(--cedh-accent-soft); border: 1rpx solid var(--cedh-accent-line); border-radius: var(--cedh-radius-2); }
.modifier-symbol { font-size: 26px; line-height: 1.2; color: var(--cedh-accent-ink); }
.pending-link { display: flex; justify-content: space-between; align-items: center; gap: var(--cedh-space-3); width: 100%; margin: 0; padding: var(--cedh-space-4); text-align: left; background: var(--cedh-accent-soft); color: var(--cedh-accent-ink); border: 1rpx solid var(--cedh-accent-line); border-radius: var(--cedh-radius-2); }
.pending-link-hint { margin-top: 4px; font-size: 12px; line-height: 1.6; color: var(--cedh-text-soft); }
.desk-heading { display: flex; flex-direction: column; gap: var(--cedh-space-3); }
.desk-title { font-size: 24px; line-height: 1.3; font-weight: 400; }
.active-reference { display: flex; align-items: center; flex-wrap: wrap; gap: 0 12px; padding-bottom: var(--cedh-space-3); border-bottom: var(--cedh-hairline); }
.reference-label { color: var(--cedh-text-soft); font-size: 12px; }
.reference-card, .reveal-name { min-width: 44px; min-height: 44px; margin: 0; padding: 10px 0; background: transparent; color: var(--cedh-text); border-radius: var(--cedh-radius-control-sm); font-size: 13px; line-height: 1.6; text-align: left; }
.ready-note { display: flex; flex-direction: column; gap: var(--cedh-space-3); align-items: flex-start; padding: var(--cedh-space-4) 0; }
.ready-mark { color: var(--cedh-accent-ink); font-size: 28px; line-height: 1; }
.pending-source { padding: var(--cedh-space-5); display: flex; flex-direction: column; gap: var(--cedh-space-3); background: var(--cedh-surface-raised); }
.source-kind { color: var(--cedh-accent-ink); font-size: 12px; }
.source-id { color: var(--cedh-text-soft); font-size: 12px; }
.source-title { font-size: 22px; line-height: 1.4; font-weight: 400; }
.source-resolve { justify-content: space-between; gap: 12px; text-align: left; color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); border-color: var(--cedh-accent-line); margin-top: var(--cedh-space-2); }
.source-options { min-height: 44px; display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 8px 0; color: var(--cedh-text-soft); background: transparent; border-radius: var(--cedh-radius-control-sm); font-size: 12px; line-height: 1.5; }
.revealed-row, .order-row { display: flex; align-items: center; gap: 10px; border-bottom: var(--cedh-hairline); }
.reveal-index { font-size: 12px; color: var(--cedh-text-soft); }
.reveal-name { flex: 1; }
.reveal-kind { color: var(--cedh-accent-ink); font-size: 12px; white-space: nowrap; }
.order-heading { display: flex; flex-direction: column; gap: var(--cedh-space-2); margin-top: var(--cedh-space-3); }
.order-row { padding: 6px 0; }
.order-name { flex: 1; min-width: 0; font-size: 14px; line-height: 1.6; }
.order-button { flex: 0 0 44px; padding: 8px; font-size: 18px; }
.table-note { display: flex; align-items: baseline; gap: 12px; padding-bottom: 12px; border-bottom: var(--cedh-hairline); }
.note-index { color: var(--cedh-accent-ink); font-size: 12px; }
.turn-console { display: flex; flex-direction: column; gap: var(--cedh-space-4); padding: var(--cedh-space-5); background: var(--cedh-surface-raised); }
.console-cost { font-size: 12px; color: var(--cedh-text-soft); white-space: nowrap; }
.cost-value { font-size: 18px; color: var(--cedh-accent-ink); padding-left: 4px; }
.die-display { display: flex; align-items: center; gap: 12px; min-width: 0; }
.die-tile { flex: 0 0 50px; height: 50px; display: flex; align-items: center; justify-content: center; font-size: 30px; line-height: 1; border: var(--cedh-hairline); border-radius: var(--cedh-radius-2); color: var(--cedh-accent-ink); background: var(--cedh-input-glass); }
.die-chaos { color: var(--cedh-accent-ink); border-color: var(--cedh-accent-line); background: var(--cedh-accent-soft); }
.die-blank, .die-idle { color: var(--cedh-text-soft); }
.status-detail { font-size: 12px; line-height: 1.5; color: var(--cedh-text-soft); }
.die-result { font-size: 17px; line-height: 1.5; margin-top: 2px; }
.next-turn { flex: 0 0 auto; flex-direction: column; }
.next-turn-hint { font-size: 11px; margin-top: 2px; }
.console-rule { color: var(--cedh-text-soft); font-size: 12px; line-height: 1.8; }
.planechase-page .card-art-credit { color: var(--cedh-text-soft); font-size: 10px; }
.action-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 10px var(--cedh-page-x) calc(12px + env(safe-area-inset-bottom)); background: var(--cedh-surface-solid); border-top: var(--cedh-hairline); }
.dock-summary { display: flex; align-items: baseline; gap: 7px; margin: 0 auto 9px; max-width: 680px; font-size: 11px; line-height: 1.6; color: var(--cedh-text-soft); }
.save-indicator { width: 5px; height: 5px; flex: 0 0 5px; border-radius: var(--cedh-radius-pill); background: var(--cedh-accent-ink); }
.save-pending { background: var(--cedh-text); }
.dock-buttons { display: flex; gap: var(--cedh-space-3); max-width: 680px; margin: 0 auto; }
.pc-primary { flex: 1; min-width: 0; min-height: 62px; padding: 10px 12px; letter-spacing: 0; }
.primary-copy { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.primary-label { font-size: 14px; font-weight: 600; line-height: 1.4; }
.primary-hint { font-size: 12px; font-weight: 400; line-height: 1.5; }
.undo-button { flex: 0 0 64px; }
.inspect-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: center; background: var(--cedh-overlay-glass); padding: 12px; }
.inspect-panel { width: 100%; max-width: 640px; background: var(--cedh-surface-solid); border: var(--cedh-hairline); border-radius: var(--cedh-radius-control-sm); box-shadow: var(--cedh-shadow-soft); overflow: hidden; }
.inspect-header { padding: var(--cedh-space-4); border-bottom: var(--cedh-hairline); }
.inspect-header > view { min-width: 0; }
.inspect-header .pc-button { flex: 0 0 auto; }
.inspect-scroll { height: 70vh; }
.inspect-art { position: relative; height: 65vw; max-height: 430px; background: var(--cedh-image-placeholder); overflow: hidden; }
.inspect-card { position: absolute; left: 50%; top: 50%; width: 65vw; height: 91vw; max-width: 430px; max-height: 598px; transform: translate(-50%, -50%) rotate(90deg); background: var(--cedh-image-placeholder); }
.inspect-fallback { display: flex; height: 100%; padding: 20px; flex-direction: column; justify-content: center; gap: 16px; }
.inspect-text { display: flex; flex-direction: column; gap: var(--cedh-space-3); padding: var(--cedh-space-5); background: var(--cedh-surface-muted); }
.rules-text { white-space: pre-wrap; }
@media (max-width: 350px) {
  .session-title { font-size: 21px; }
  .meter-value { font-size: 24px; }
  .plane-name, .desk-title { font-size: 22px; }
  .die-tile { flex-basis: 44px; height: 44px; }
  .die-display { gap: 8px; }
  .die-result { font-size: 15px; }
  .next-turn { padding: 8px; }
}
@media (prefers-reduced-motion: reduce) {
  .pc-button, .pc-primary { transition: none; }
}
