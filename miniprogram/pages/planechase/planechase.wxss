@import "../../styles/themes/dark-table.wxss";
.planechase-page { padding-top: var(--cedh-space-5); padding-bottom: calc(160px + env(safe-area-inset-bottom)); color: var(--cedh-text); }
.tool-shell { display: flex; flex-direction: column; gap: var(--cedh-space-5); }
.session-header, .session-status, .turn-row, .inspect-header { display: flex; align-items: center; justify-content: space-between; gap: var(--cedh-space-3); }
.session-eyebrow, .status-detail { font-size: 12px; line-height: 1.5; color: var(--cedh-text-soft); }
.session-title { margin-top: var(--cedh-space-2); font-family: var(--cedh-font-serif); font-size: 24px; line-height: 1.3; }
.phase-badge { padding: 6px 10px; color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); border: 1rpx solid var(--cedh-accent-line); border-radius: var(--cedh-radius-pill); font-size: 13px; }
.setup-toggle { flex: 0 0 auto; }
.work-panel, .notice-panel, .plane-card { background: var(--cedh-surface-muted); border: var(--cedh-hairline); border-radius: var(--cedh-radius-2); }
.work-panel, .notice-panel { padding: var(--cedh-space-4); display: flex; flex-direction: column; gap: var(--cedh-space-3); }
.notice-panel { border-left: 3px solid var(--cedh-accent); }
.error-panel { border-color: var(--cedh-accent-ink); }
.panel-heading, .source-title { font-size: 15px; font-weight: 600; line-height: 1.5; }
.body-copy { font-size: 14px; line-height: 1.7; color: var(--cedh-text); overflow-wrap: anywhere; }
.muted-copy { color: var(--cedh-text-soft); }
.action-row, .count-row { display: flex; flex-wrap: wrap; gap: 8px; }
.pc-button { display: flex; justify-content: center; align-items: center; min-height: 44px; margin: 0; padding: 10px 14px; font-size: 13px; line-height: 1.45; color: var(--cedh-text); background: var(--cedh-input-glass); border: var(--cedh-hairline); border-radius: var(--cedh-radius-control-sm); transition: opacity 140ms ease; }
.pc-button[disabled], .pc-primary[disabled] { opacity: 0.42; color: var(--cedh-text); background: var(--cedh-surface-muted); }
.accent-button, .count-chip.is-selected { color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); border-color: var(--cedh-accent-line); }
.count-chip { flex: 1; min-width: 44px; }
.pending-source { border-top: var(--cedh-hairline); padding-top: var(--cedh-space-4); display: flex; flex-direction: column; gap: var(--cedh-space-3); }
.revealed-row, .order-row { display: flex; align-items: center; gap: 8px; }
.reveal-name { flex: 1; justify-content: flex-start; text-align: left; }
.order-name { flex: 1; min-width: 0; font-size: 14px; line-height: 1.5; }
.order-button { flex: 0 0 44px; padding: 8px; }
.plane-card { overflow: hidden; }
.plane-art { display: block; position: relative; width: 100%; padding-top: 44.6%; border-radius: 0; background: var(--cedh-image-placeholder); overflow: hidden; }
.plane-art-main { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 1; background: var(--cedh-image-placeholder); }
.plane-art-base { position: absolute; left: 50%; top: 50%; width: 44.6%; height: 224%; opacity: 0.55; background: var(--cedh-image-placeholder); z-index: 0; transform: translate(-50%, -50%) rotate(90deg) scale(1.35); }
.art-caption { position: absolute; right: 10px; bottom: 10px; z-index: 2; padding: 6px 10px; border-radius: var(--cedh-radius-pill); background: var(--cedh-overlay-glass); color: var(--cedh-text); font-size: 12px; line-height: 1.5; }
.plane-text { display: flex; flex-direction: column; gap: var(--cedh-space-3); padding: var(--cedh-space-4); }
.plane-heading { padding-bottom: var(--cedh-space-2); }
.plane-name { font-size: 22px; font-family: var(--cedh-font-serif); line-height: 1.4; margin-bottom: 4px; }
.plane-line-chaos { border-left: 3px solid var(--cedh-accent); padding: 8px 12px; color: var(--cedh-accent-ink); background: var(--cedh-accent-soft); }
.die-result { font-size: 22px; line-height: 1.4; margin-top: 4px; }
.action-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 12px var(--cedh-page-x) calc(12px + env(safe-area-inset-bottom)); background: var(--cedh-surface-solid); border-top: var(--cedh-hairline); }
.dock-summary { margin-bottom: 8px; font-size: 12px; line-height: 1.5; color: var(--cedh-text-soft); }
.dock-buttons { display: flex; gap: 10px; }
.pc-primary { flex: 1; min-width: 0; min-height: 48px; padding: 12px; font-size: 14px; letter-spacing: 0; line-height: 1.5; color: var(--cedh-ink); background: var(--cedh-accent-ink); border: 0; box-shadow: none; }
.undo-button { flex: 0 0 60px; }
.inspect-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: center; background: var(--cedh-overlay-glass); padding: 12px; }
.inspect-panel { width: 100%; max-width: 640px; background: var(--cedh-surface-solid); border: var(--cedh-hairline); border-radius: var(--cedh-radius-control-sm); overflow: hidden; }
.inspect-header { padding: 12px 16px; border-bottom: var(--cedh-hairline); }
.inspect-scroll { height: 70vh; }
.inspect-art { position: relative; height: 65vw; max-height: 430px; background: var(--cedh-image-placeholder); overflow: hidden; }
.inspect-card { position: absolute; left: 50%; top: 50%; width: 65vw; height: 91vw; max-width: 430px; max-height: 598px; transform: translate(-50%, -50%) rotate(90deg); background: var(--cedh-image-placeholder); }
.inspect-fallback { display: flex; height: 100%; padding: 20px; flex-direction: column; justify-content: center; gap: 16px; }
.inspect-text { display: flex; flex-direction: column; gap: 10px; padding: 16px; }
.rules-text { white-space: pre-wrap; }
@media (prefers-reduced-motion: reduce) { .pc-button { transition: none; } }
