<view class="page meta">
  <particle-background paused="{{detail || monthlyDetail ? true : false}}" palette="meta"></particle-background>

  <view class="content-layer meta-shell">
    <view class="month-tabs" aria-role="tablist" aria-label="榜单来源">
      <button hover-class="pressable-active" hover-stay-time="120" class="month-button month-tab {{mode === 'monthly' ? 'is-selected' : ''}}" aria-role="tab" aria-selected="{{mode === 'monthly'}}" data-mode="monthly" bindtap="selectMode">赛事月报</button>
      <button hover-class="pressable-active" hover-stay-time="120" class="month-button month-tab {{mode === 'editorial' ? 'is-selected' : ''}}" aria-role="tab" aria-selected="{{mode === 'editorial'}}" data-mode="editorial" bindtap="selectMode">小屋编辑榜</button>
    </view>
    <block wx:if="{{mode === 'monthly'}}">
      <view class="month-head">
        <view><view class="meta-title">环境月报</view><view class="month-caption">公开赛事，逐月追踪</view></view>
        <picker wx:if="{{monthSummary}}" range="{{monthPeriods}}" value="{{monthIndex}}" bindchange="changeMonth" aria-label="选择月报月份">
          <view class="month-date">{{monthSummary.period}} <text aria-hidden="true">⌄</text></view>
        </picker>
      </view>
      <view wx:if="{{monthLoading}}" class="month-status" aria-live="polite">正在读取月报</view>
      <view wx:if="{{monthError}}" class="month-notice" aria-live="polite"><text>{{monthError}}</text><button hover-class="pressable-active" hover-stay-time="120" class="month-button month-link" bindtap="retryMonthly" disabled="{{monthLoading}}">重试</button></view>
      <block wx:if="{{monthSummary}}">
        <view class="month-overview">
          <view><text class="month-number mono">{{monthSummary.events}}</text><text class="month-caption">场赛事</text></view>
          <view><text class="month-number mono">{{monthSummary.entries}}</text><text class="month-caption">次参赛</text></view>
          <view><text class="month-number mono">{{monthSummary.coverage}}%</text><text class="month-caption">主将覆盖</text></view>
        </view>
        <view class="month-asof">截至 {{monthSummary.asOf}}　最近 90 天</view>
        <view class="month-search-label">搜索套牌或主将</view>
        <input class="month-search" value="{{monthQuery}}" placeholder="中文常用名或英文牌名" aria-label="搜索套牌或主将" bindinput="searchMonthly" maxlength="80" />
        <view class="month-filters">
          <view class="month-sort">
            <button hover-class="pressable-active" hover-stay-time="120" class="month-button {{monthOrder === 'score' ? 'is-selected' : ''}}" data-order="score" bindtap="selectMonthlyOrder">表现</button>
            <button hover-class="pressable-active" hover-stay-time="120" class="month-button {{monthOrder === 'entries' ? 'is-selected' : ''}}" data-order="entries" bindtap="selectMonthlyOrder">出场</button>
          </view>
          <picker range="{{monthColorLabels}}" value="{{monthColorIndex}}" bindchange="changeMonthlyColor" aria-label="颜色筛选"><view class="month-filter-value">{{monthColorLabels[monthColorIndex]}} ⌄</view></picker>
          <button hover-class="pressable-active" hover-stay-time="120" class="month-button {{monthHighSample ? 'is-selected' : ''}}" aria-pressed="{{monthHighSample}}" bindtap="toggleHighSample">100+ 参赛</button>
        </view>
        <view class="month-tier" wx:for="{{monthGroups}}" wx:key="id" wx:for-item="group" style="--tier-rgb: {{group.rgb}};">
          <view class="month-tier-head"><view><text class="month-tier-label">{{group.label}}</text><text class="month-caption">{{group.rows.length}} 套</text></view><text wx:if="{{group.id !== 'watch'}}" class="month-caption">{{group.hint}}</text><button wx:else class="month-button month-link" bindtap="toggleMonthWatch">{{group.expanded ? '收起' : '展开'}}</button></view>
          <block wx:if="{{group.expanded}}">
            <button wx:for="{{group.rows}}" wx:for-item="row" wx:key="id" class="month-button month-row" data-id="{{row.id}}" bindtap="openMonthlyDetail" aria-label="{{row.name}}，{{row.entries}} 次参赛，查看赛绩">
              <view class="month-row-top"><view class="month-arts" aria-hidden="true"><image wx:for="{{row.commanders}}" wx:for-item="card" wx:key="oracleId" src="{{card.image}}" mode="aspectFit" lazy-load="{{true}}"></image></view><view class="month-row-name">{{row.displayName}}<view wx:if="{{row.deltaLabel && row.tier !== 'watch'}}" class="month-caption">较上期 {{row.deltaLabel}}</view></view><view class="month-row-score mono">{{row.scoreLabel}}<text class="month-caption">表现分</text></view></view>
              <view class="month-row-stats"><text>胜率 {{row.winLabel}}</text><text>晋级 {{row.conversionLabel}}</text><text>{{row.entries}} 次参赛</text></view>
            </button>
          </block>
        </view>
        <view wx:if="{{!monthGroups.length}}" class="month-empty">没有符合筛选的套牌</view>
        <view class="month-source"><button hover-class="pressable-active" hover-stay-time="120" class="month-button month-link" bindtap="copyMonthlySource">数据来自 TopDeck.gg ↗</button><button hover-class="pressable-active" hover-stay-time="120" class="month-button month-link" bindtap="toggleMonthMethod" aria-expanded="{{monthMethodOpen}}">统计口径 {{monthMethodOpen ? '−' : '+'}}</button></view>
        <view wx:if="{{monthMethodOpen}}" class="month-method">
          <view>收录 50 人以上、至少 4 轮瑞士轮的已完成 EDH 赛事。按开赛日期进入 90 天窗口，完赛时间不晚于月末。</view>
          <view>胜率只计算已完成的四人瑞士轮，和局计入分母，轮空和淘汰轮另行排除。晋级人数由淘汰阶段实际牌手确认。</view>
          <view>表现分以 50 为基准，胜率与按赛事晋级机会修正的晋级率各占一半，小样本向基准收缩。</view>
          <view>至少 {{monthSummary.minEntries}} 次参赛、{{monthSummary.minPilots}} 位牌手、{{monthSummary.minEvents}} 场赛事才参与分档。区间来自赛事重采样，反映观测赛绩。</view>
          <view>本期排除 {{monthSummary.excluded}} 场不符合口径或数据不完整的赛事。出场占比独立展示，不增加表现分。</view>
          <view>参考 Lemora’s Cards 的胜率与晋级率等权思路，使用本项目公开计算模型。每月自动更新，旧期保留。</view>
        </view>
      </block>
    </block>
    <block wx:else>
    <view class="meta-head" wx:if="{{summary}}">
      <view class="meta-title">{{summary.title}}</view>
      <view class="meta-byline mono">{{summary.bylineLine}}</view>
    </view>

    <view class="tier-block" wx:for="{{tierGroups}}" wx:key="id" style="--tier-rgb: {{item.rgb}};">
      <view
        class="tier-head"
        aria-role="button"
        aria-label="{{item.label}} 档，{{item.count}} 套，{{item.expanded ? '收起' : '展开'}}"
        hover-class="pressable-active"
        hover-stay-time="120"
        data-id="{{item.id}}"
        bindtap="toggleTier"
      >
        <text class="tier-label mono">{{item.label}}</text>
        <view class="tier-rule"></view>
        <text class="tier-count mono">{{item.count}}</text>
        <text class="tier-toggle mono">{{item.expanded ? '−' : '+'}}</text>
      </view>

      <!-- 收起的档位整块不进渲染树。两点都不能省：
           · 必须用 wx:if 而不是 hidden——hidden 只是不显示，image 照样会发请求。
           · wx:if 必须挂在外面这层 block 上，不能与 wx:for 写在同一个元素上。
             同元素时 wx:for 会重绑循环作用域，wx:if 里的 item 指外层档位还是被内层遮蔽
             并无保证，不同基础库版本表现不一致——「有时候整档不显示」就是这么来的。 -->
      <block wx:if="{{item.expanded}}">
      <view
        class="deck-row"
        wx:for="{{item.entries}}"
        wx:for-item="deck"
        wx:key="id"
        aria-role="button"
        aria-label="{{deck.displayNameZh}}，查看详情"
        hover-class="pressable-active"
        hover-stay-time="120"
        data-id="{{deck.id}}"
        bindtap="openDetail"
      >
        <view class="deck-art deck-art-{{deck.art.mode}}" wx:if="{{deck.art.mode !== 'none'}}" aria-hidden="true">
          <image
            wx:for="{{deck.art.images}}"
            wx:for-item="face"
            wx:key="en"
            class="deck-art-image"
            src="{{face.art}}"
            mode="aspectFill"
            lazy-load="{{true}}"
          ></image>
        </view>
        <view class="deck-body">
          <view class="deck-name">{{deck.displayNameZh}}</view>
          <view class="deck-en mono" wx:if="{{deck.showEnName}}">{{deck.displayNameEn}}</view>
        </view>
        <view class="deck-tags">
          <text class="deck-tag mono" wx:for="{{deck.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
      </block>
    </view>

    <view class="meta-tail mono">{{summary.tailLine}}</view>
    </block>
  </view>

  <view class="detail-mask" wx:if="{{monthlyDetail}}" bindtap="closeMonthlyDetail" catchtouchmove="stopPropagation">
    <view class="detail-panel month-detail" catchtap="stopPropagation" aria-role="dialog" aria-label="{{monthlyDetail.name}}赛事表现">
      <view class="month-detail-head"><view class="detail-name">{{monthlyDetail.name}}</view><button hover-class="pressable-active" hover-stay-time="120" class="month-button" bindtap="closeMonthlyDetail" aria-label="关闭赛绩详情">关闭</button></view>
      <scroll-view class="detail-scroll" scroll-y="{{true}}">
        <view class="detail-en">{{monthlyDetail.nameEn}}</view>
        <view class="month-detail-arts"><image wx:for="{{monthlyDetail.commanders}}" wx:key="oracleId" src="{{item.normal}}" mode="aspectFit" lazy-load="{{true}}"></image></view>
        <view class="month-detail-metrics"><view>表现分 <text>{{monthlyDetail.scoreLabel}}</text></view><view>95% 区间 <text>{{monthlyDetail.intervalLabel}}</text></view><view>瑞士轮胜率 <text>{{monthlyDetail.wins}} / {{monthlyDetail.games}}　{{monthlyDetail.winLabel}}</text></view><view>和局率 <text>{{monthlyDetail.drawRate}}%</text></view><view>晋级率 <text>{{monthlyDetail.cuts}} / {{monthlyDetail.cutEntries}}　{{monthlyDetail.conversionLabel}}</text></view><view>参赛占比 <text>{{monthlyDetail.shareLabel}}</text></view><view>独立牌手 <text>{{monthlyDetail.pilots}} 位</text></view><view>赛事覆盖 <text>{{monthlyDetail.events}} 场</text></view><view>本月出场 <text>{{monthlyDetail.monthEntries}} 次</text></view></view>
        <view class="detail-section-title">来源赛事</view>
        <button wx:for="{{monthlyDetail.sources}}" wx:key="id" class="month-button month-event" data-title="{{item.title}}" bindtap="copyMonthlyEvent">{{item.title}}<text class="month-caption">复制赛事名</text></button>
      </scroll-view>
    </view>
  </view>

  <view class="detail-mask" wx:if="{{detail}}" bindtap="closeDetail" catchtouchmove="stopPropagation">
    <view class="detail-panel surface" catchtap="stopPropagation" style="--tier-rgb: {{detail.tierRgb}};">
      <view class="detail-head">
        <view class="detail-kicker mono">{{detail.tierLabel}}</view>
        <view class="detail-name">{{detail.nameZh}}</view>
        <view class="detail-en mono" wx:if="{{detail.showEnName}}">{{detail.fullNameEn}}</view>
      </view>

      <view class="detail-commanders">
        <view
          class="detail-commander"
          wx:for="{{detail.art.images}}"
          wx:key="en"
          aria-role="button"
          aria-label="查看 {{item.cn}} 卡图"
          hover-class="pressable-active"
          hover-stay-time="120"
          data-url="{{item.normal}}"
          bindtap="previewCommander"
        >
          <view class="detail-commander-art-box">
            <image class="detail-commander-art" src="{{item.art}}" mode="widthFix" lazy-load="{{true}}"></image>
          </view>
          <view class="detail-commander-name">{{item.cn}}</view>
        </view>
      </view>

      <scroll-view class="detail-scroll" scroll-y="{{true}}">
        <view class="detail-section" wx:if="{{detail.summary}}">
          <view class="detail-text">{{detail.summary}}</view>
        </view>

        <view class="detail-section" wx:if="{{detail.winConditions.length}}">
          <view class="detail-section-title mono">制胜路线</view>
          <view class="detail-item" wx:for="{{detail.winConditions}}" wx:key="*this">{{item}}</view>
        </view>

        <view class="detail-section" wx:if="{{detail.strengths.length}}">
          <view class="detail-section-title mono">优势</view>
          <view class="detail-item" wx:for="{{detail.strengths}}" wx:key="*this">{{item}}</view>
        </view>

        <view class="detail-section" wx:if="{{detail.weaknesses.length}}">
          <view class="detail-section-title mono">劣势</view>
          <view class="detail-item" wx:for="{{detail.weaknesses}}" wx:key="*this">{{item}}</view>
        </view>

        <view class="detail-section" wx:if="{{detail.analysis}}">
          <view class="detail-section-title mono">评价</view>
          <view class="detail-text">{{detail.analysis}}</view>
        </view>
      </scroll-view>

      <view class="detail-actions">
        <view
          class="secondary-button detail-button detail-button-primary"
          wx:if="{{detail.hasDeckUrl}}"
          aria-role="button"
          aria-label="复制参考牌表链接"
          hover-class="pressable-active"
          hover-stay-time="120"
          bindtap="copyDeckUrl"
        >复制牌表链接</view>
        <view
          class="secondary-button detail-button"
          aria-role="button"
          aria-label="关闭详情"
          hover-class="pressable-active"
          hover-stay-time="120"
          bindtap="closeDetail"
        >关闭</view>
      </view>
    </view>
  </view>
  <view class="card-art-credit">卡面图像来自 Scryfall，美术版权归 Wizards of the Coast 及画师所有</view>
</view>
