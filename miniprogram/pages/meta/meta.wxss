@import "../../styles/themes/dark-table.wxss";

.meta-shell {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-4);
  /* 手势条区域要留出，否则最后一条套牌会压在 home indicator 底下 */
  padding-bottom: calc(var(--cedh-space-6) + env(safe-area-inset-bottom));
}

/* ===== 版本抬头 =====
   刻意不套 .surface：套牌行已经是 surface，抬头再用同一种卡片处理就变成「又一张卡」，
   层级被抹平。这里用一条发丝分割线收尾即可，抬头是标题不是内容。 */
.meta-head {
  padding-bottom: var(--cedh-space-3);
  border-bottom: 1rpx solid var(--cedh-line);
}

.meta-title {
  color: var(--cedh-text);
  font-size: var(--cedh-text-18);
  font-weight: 700;
  line-height: 1.3;
}

/* 事实行与展开入口同处一行：baseline 对齐，右侧入口不换行 */
.meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cedh-space-3);
}

.meta-facts {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 触控热区 ≥88rpx（44pt）：视觉上只是一行小字，靠 padding 把热区撑起来 */
.methodology-toggle {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  min-height: 88rpx;
  padding-left: 16rpx;
  color: var(--cedh-accent-ink);
  font-size: var(--cedh-text-11);
  white-space: nowrap;
  text-decoration: underline;
}

.methodology {
  display: block;
  padding-bottom: var(--cedh-space-2);
}

.methodology-text,
.methodology-note {
  display: block;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  line-height: 1.7;
  white-space: pre-line;
}

.methodology-note {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-text-faint);
}

/* ===== 档位分组 ===== */
.tier-block {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-2);
}

.tier-head {
  display: flex;
  align-items: baseline;
  gap: var(--cedh-space-3);
  padding-left: 18rpx;
  border-left: 8rpx solid rgb(var(--tier-rgb));
}

.tier-label {
  color: rgb(var(--tier-rgb));
  font-size: var(--cedh-text-20);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
}

/* 档位说明是有含义的正文，不能用 --cedh-text-faint（0.46 alpha 在近黑底上仅 4.42:1，
   差 0.08 未达 AA 正文 4.5:1）；提到 soft（0.68）后是 9.08:1 */
.tier-desc {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  line-height: 1.5;
}

/* ===== 套牌行 ===== */
.deck-row {
  display: flex;
  align-items: center;
  gap: var(--cedh-space-3);
  padding: var(--cedh-space-3);
  border-left: 4rpx solid rgba(var(--tier-rgb), 0.55);
}

.deck-art {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  width: 132rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: var(--cedh-radius-1);
  background: rgba(0, 0, 0, 0.45);
}

/* 单主将整幅、双拍档左右分屏——与结算页、套牌试玩主将区同一语汇 */
.deck-art-image {
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
}

.deck-art-dual .deck-art-image + .deck-art-image {
  border-left: 1rpx solid rgba(0, 0, 0, 0.55);
}

.deck-body {
  flex: 1 1 auto;
  min-width: 0;
}

.deck-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-14);
  font-weight: 700;
  line-height: 1.35;
}

.deck-en {
  margin-top: 2rpx;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.06em;
}

.deck-commanders {
  margin-top: 6rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  line-height: 1.5;
}

.deck-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.deck-tag {
  padding: 2rpx 10rpx;
  color: var(--cedh-accent-ink);
  background: var(--cedh-accent-soft);
  border: 1rpx solid var(--cedh-accent-line);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.04em;
}

/* ===== 页脚署名 ===== */
.meta-foot {
  margin-top: var(--cedh-space-2);
}

/* 署名与图像版权是随数据走的义务，必须真的看得清：同样避开 4.42:1 的 faint，
   字号也提到 11 而不是 10 —— 这不是可以退让的装饰文本 */
.meta-credit,
.image-credit {
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  line-height: 1.6;
}

.image-credit {
  margin-top: 6rpx;
}

/* ===== 详情面板 ===== */
.detail-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
  animation: meta-mask-in 160ms ease-out;
}

/* 从底部滑入，而不是「啪」地出现：面板由底部触发、也从底部来，
   保持空间连续性。只动 transform / opacity，不触发重排。 */
.detail-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding: var(--cedh-space-4);
  padding-bottom: calc(var(--cedh-space-4) + env(safe-area-inset-bottom));
  animation: meta-sheet-in 220ms cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes meta-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes meta-sheet-in {
  from {
    opacity: 0;
    transform: translateY(8%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .detail-mask,
  .detail-panel {
    animation: none;
  }
}

.detail-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-18);
  font-weight: 700;
  line-height: 1.3;
}

.detail-en {
  margin-top: 2rpx;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-11);
  letter-spacing: 0.06em;
}

.detail-commanders {
  display: flex;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-3);
}

.detail-commander {
  flex: 1 1 0;
  min-width: 0;
}

/* 卡图构图里人物头部几乎总在最上缘，而 aspectFill 是「居中裁切」：
   在约 2.5:1 的窗口里看 1.37:1 的 art_crop，上下各被切掉约 23%，切掉的正好是头。
   改为 widthFix（按宽缩放、高度随原图比例）+ 顶部对齐 + 容器裁下缘——只切脚不切头。 */
.detail-commander-art-box {
  position: relative;
  width: 100%;
  height: 168rpx;
  overflow: hidden;
  border-radius: var(--cedh-radius-1);
  background: rgba(0, 0, 0, 0.45);
}

.detail-commander-art {
  display: block;
  width: 100%;
}

.detail-commander-name {
  margin-top: 6rpx;
  color: var(--cedh-text);
  font-size: var(--cedh-text-12);
  line-height: 1.4;
}

.detail-commander-en {
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.04em;
}

.detail-scroll {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: var(--cedh-space-3);
}

.detail-section + .detail-section {
  margin-top: var(--cedh-space-3);
}

.detail-section-title {
  color: var(--cedh-accent);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.detail-text {
  margin-top: 6rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.75;
}

.detail-item {
  margin-top: 6rpx;
  padding-left: 20rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.6;
  text-indent: -20rpx;
}

.detail-item::before {
  content: "· ";
  color: var(--cedh-accent);
}

.detail-actions {
  display: flex;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-3);
}

.detail-button {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  font-size: var(--cedh-text-12);
  white-space: nowrap;
}
