@import "../../styles/themes/dark-table.wxss";

.meta-shell {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-4);
  /* 手势条区域要留出，否则最后一条套牌会压在 home indicator 底下 */
  padding-bottom: calc(var(--cedh-space-6) + env(safe-area-inset-bottom));
}

/* ===== 抬头 =====
   只有标题与署名两行，不套 .surface：抬头是标题不是内容，
   与下方列表用留白区隔即可，不需要卡片。 */
.meta-head {
  padding: var(--cedh-space-4) 0 var(--cedh-space-2);
}

.meta-title {
  color: var(--cedh-text);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.2;
}

.meta-byline {
  margin-top: 10rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
}

/* ===== 档位分组 =====
   页面的签名元素：每档只有一处强标记——档位色的大号等宽标签 + 延伸到右缘的发丝线
   + 该档数量。全页 5 个标记，其余一律安静。数量放在档位上而不是总计里，因为分布
   本身就是信息（T0 只有 2 个、T3 有 22 个）。 */
.tier-block {
  margin-top: var(--cedh-space-5);
}

.tier-head {
  display: flex;
  align-items: center;
  gap: var(--cedh-space-3);
  padding-bottom: var(--cedh-space-2);
}

.tier-label {
  flex: 0 0 auto;
  color: rgb(var(--tier-rgb));
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.12em;
}

.tier-rule {
  flex: 1 1 auto;
  height: 1rpx;
  background: rgba(var(--tier-rgb), 0.42);
}

.tier-count {
  flex: 0 0 auto;
  color: rgba(var(--tier-rgb), 0.72);
  font-size: var(--cedh-text-11);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.08em;
}

/* ===== 套牌行 =====
   刻意不套 .surface、不加彩色左边框：56 张卡片加 56 条彩线会跟档位标记抢注意力。
   行间只用一条发丝线，层级交给留白与字号。 */
.deck-row {
  display: flex;
  align-items: center;
  gap: var(--cedh-space-3);
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--cedh-line);
}

.deck-row:last-child {
  border-bottom: 0;
}

.deck-art {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  width: 132rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: var(--cedh-radius-1);
  background: rgba(0, 0, 0, 0.45);
}

/* 单主将整幅、双拍档左右分屏——与结算页、套牌试玩主将区同一语汇 */
.deck-art-image {
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
}

.deck-art-dual .deck-art-image + .deck-art-image {
  border-left: 1rpx solid rgba(0, 0, 0, 0.55);
}

.deck-body {
  flex: 1 1 auto;
  min-width: 0;
}

.deck-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-14);
  font-weight: 700;
  line-height: 1.35;
}

/* 中文名下方的英文原名：等宽、退一档，作注记而不与中文名争主次 */
.deck-en {
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.04em;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 主将名是有含义的内容，保持 soft（9.08:1）；与上方英文原名靠字号和等宽区分，
   不靠压暗——压到 faint 只有 4.42:1，未达 AA 正文 */
.deck-commanders {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 原型标签移到行尾右对齐：它是分类而不是标题的一部分，
   放在名字下方会和主将名挤成三行，行高忽高忽低 */
.deck-tags {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.deck-tag {
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.04em;
  white-space: nowrap;
}

/* ===== 详情面板 ===== */
.detail-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
  animation: meta-mask-in 160ms ease-out;
}

/* 从底部滑入，而不是「啪」地出现：面板由底部触发、也从底部来，
   保持空间连续性。只动 transform / opacity，不触发重排。 */
.detail-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding: var(--cedh-space-4);
  padding-bottom: calc(var(--cedh-space-4) + env(safe-area-inset-bottom));
  animation: meta-sheet-in 220ms cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes meta-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes meta-sheet-in {
  from {
    opacity: 0;
    transform: translateY(8%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .detail-mask,
  .detail-panel {
    animation: none;
  }
}

.detail-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-18);
  font-weight: 700;
  line-height: 1.3;
}

.detail-en {
  margin-top: 2rpx;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-11);
  letter-spacing: 0.06em;
}

.detail-commanders {
  display: flex;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-3);
}

.detail-commander {
  flex: 1 1 0;
  min-width: 0;
}

/* 卡图构图里人物头部几乎总在最上缘，而 aspectFill 是「居中裁切」：
   在约 2.5:1 的窗口里看 1.37:1 的 art_crop，上下各被切掉约 23%，切掉的正好是头。
   改为 widthFix（按宽缩放、高度随原图比例）+ 顶部对齐 + 容器裁下缘——只切脚不切头。 */
.detail-commander-art-box {
  position: relative;
  width: 100%;
  height: 168rpx;
  overflow: hidden;
  border-radius: var(--cedh-radius-1);
  background: rgba(0, 0, 0, 0.45);
}

.detail-commander-art {
  display: block;
  width: 100%;
}

.detail-commander-name {
  margin-top: 6rpx;
  color: var(--cedh-text);
  font-size: var(--cedh-text-12);
  line-height: 1.4;
}

.detail-scroll {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: var(--cedh-space-3);
}

.detail-section + .detail-section {
  margin-top: var(--cedh-space-3);
}

.detail-section-title {
  color: var(--cedh-accent);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.detail-text {
  margin-top: 6rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.75;
}

/* 不用点号做项目符号：条目本身已经断行分开，圆点只是多一层噪声。
   靠行距与左侧留白成列即可。 */
.detail-item {
  margin-top: 8rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.6;
}

.detail-actions {
  display: flex;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-3);
}

.detail-button {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  font-size: var(--cedh-text-12);
  white-space: nowrap;
}
