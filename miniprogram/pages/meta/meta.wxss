@import "../../styles/themes/dark-table.wxss";

.meta-shell {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-4);
  padding-bottom: var(--cedh-space-6);
}

/* ===== 版本抬头 ===== */
.meta-head {
  padding: var(--cedh-space-4);
}

.meta-kicker {
  color: var(--cedh-accent);
  font-size: var(--cedh-text-11);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.meta-title {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-text);
  font-size: var(--cedh-text-18);
  font-weight: 700;
  line-height: 1.3;
}

.meta-meta {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-11);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.08em;
}

.methodology-toggle {
  display: inline-block;
  margin-top: var(--cedh-space-3);
  padding: 12rpx 0;
  color: var(--cedh-accent-ink);
  font-size: var(--cedh-text-12);
  text-decoration: underline;
}

.methodology,
.snapshot-note {
  margin-top: var(--cedh-space-2);
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.7;
  white-space: pre-line;
}

.snapshot-note {
  color: var(--cedh-text-faint);
}

/* ===== 档位分组 ===== */
.tier-block {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-2);
}

.tier-head {
  display: flex;
  align-items: baseline;
  gap: var(--cedh-space-3);
  padding-left: 18rpx;
  border-left: 8rpx solid rgb(var(--tier-rgb));
}

.tier-label {
  color: rgb(var(--tier-rgb));
  font-size: var(--cedh-text-20);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
}

.tier-desc {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-11);
  line-height: 1.5;
}

/* ===== 套牌行 ===== */
.deck-row {
  display: flex;
  align-items: center;
  gap: var(--cedh-space-3);
  padding: var(--cedh-space-3);
  border-left: 4rpx solid rgba(var(--tier-rgb), 0.55);
}

.deck-art {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  width: 132rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: var(--cedh-radius-1);
  background: rgba(0, 0, 0, 0.45);
}

/* 单主将整幅、双拍档左右分屏——与结算页、套牌试玩主将区同一语汇 */
.deck-art-image {
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
}

.deck-art-dual .deck-art-image + .deck-art-image {
  border-left: 1rpx solid rgba(0, 0, 0, 0.55);
}

.deck-body {
  flex: 1 1 auto;
  min-width: 0;
}

.deck-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-14);
  font-weight: 700;
  line-height: 1.35;
}

.deck-en {
  margin-top: 2rpx;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.06em;
}

.deck-commanders {
  margin-top: 6rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-11);
  line-height: 1.5;
}

.deck-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.deck-tag {
  padding: 2rpx 10rpx;
  color: var(--cedh-accent-ink);
  background: var(--cedh-accent-soft);
  border: 1rpx solid var(--cedh-accent-line);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.04em;
}

/* ===== 页脚署名 ===== */
.meta-foot {
  margin-top: var(--cedh-space-2);
}

.meta-credit,
.image-credit {
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  line-height: 1.6;
}

.image-credit {
  margin-top: 6rpx;
}

/* ===== 详情面板 ===== */
.detail-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.detail-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding: var(--cedh-space-4);
  padding-bottom: calc(var(--cedh-space-4) + env(safe-area-inset-bottom));
}

.detail-name {
  color: var(--cedh-text);
  font-size: var(--cedh-text-18);
  font-weight: 700;
  line-height: 1.3;
}

.detail-en {
  margin-top: 2rpx;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-11);
  letter-spacing: 0.06em;
}

.detail-commanders {
  display: flex;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-3);
}

.detail-commander {
  flex: 1 1 0;
  min-width: 0;
}

.detail-commander-art {
  width: 100%;
  height: 132rpx;
  border-radius: var(--cedh-radius-1);
  background: rgba(0, 0, 0, 0.45);
}

.detail-commander-name {
  margin-top: 6rpx;
  color: var(--cedh-text);
  font-size: var(--cedh-text-12);
  line-height: 1.4;
}

.detail-commander-en {
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.04em;
}

.detail-scroll {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: var(--cedh-space-3);
}

.detail-section + .detail-section {
  margin-top: var(--cedh-space-3);
}

.detail-section-title {
  color: var(--cedh-accent);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.detail-text {
  margin-top: 6rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.75;
}

.detail-item {
  margin-top: 6rpx;
  padding-left: 20rpx;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  line-height: 1.6;
  text-indent: -20rpx;
}

.detail-item::before {
  content: "· ";
  color: var(--cedh-accent);
}

.detail-actions {
  display: flex;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-3);
}

.detail-button {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  font-size: var(--cedh-text-12);
  white-space: nowrap;
}
