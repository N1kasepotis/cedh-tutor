@import "../../styles/themes/dark-table.wxss";

page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background: #050505;
}

.tracker,
.tracker-shell {
  box-sizing: border-box;
  width: 100%;
  max-width: 100vw;
  min-width: 0;
  overflow-x: hidden;
}

.tracker-shell {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-6);
}

.deck-list {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-5);
  width: 100%;
  min-width: 0;
}

.deck-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: var(--cedh-space-6) var(--cedh-space-5);
  background: var(--cedh-surface);
  border-color: var(--cedh-line);
  box-shadow:
    var(--cedh-shadow-soft),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.deck-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cedh-space-4);
  padding-right: 96rpx;
}

.commander-avatars {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
}

.commander-avatar {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 50%;
  background: var(--cedh-surface-muted);
}

.deck-name {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--cedh-text);
  font-family: var(--cedh-font-serif);
  font-size: var(--cedh-text-20);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.28;
}

.deck-name-line {
  display: block;
  white-space: nowrap;
}

.deck-name.partner {
  font-size: 28rpx;
  line-height: 1.24;
}

.deck-name.single.name-compact {
  font-size: 28rpx;
}

.deck-name.partner.name-compact {
  font-size: 26rpx;
}

.deck-name.name-tight {
  font-size: 24rpx;
}

.text-button {
  flex-shrink: 0;
  min-height: auto;
  color: var(--cedh-text-faint);
  background: transparent;
  font-size: var(--cedh-text-12);
  font-weight: 560;
  letter-spacing: 0.08em;
}

.deck-delete-button {
  position: absolute;
  top: var(--cedh-space-4);
  right: var(--cedh-space-4);
  z-index: 2;
  color: var(--cedh-danger);
  line-height: 1.3;
}

.selector-block {
  position: relative;
  margin-top: var(--cedh-space-4);
}

.commander-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 92rpx;
  padding: 0 var(--cedh-space-4);
  color: var(--cedh-text);
  background: var(--cedh-input-glass);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
  font-size: var(--cedh-text-14);
}

.deck-onboarding {
  margin-top: var(--cedh-space-3);
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-12);
  line-height: 1.55;
}

.suggestions {
  position: absolute;
  left: 0;
  right: 0;
  top: 96rpx;
  z-index: 5;
  max-height: 420rpx;
  overflow: hidden;
  background: var(--cedh-overlay-glass);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
  box-shadow: var(--cedh-shadow-soft);
}

.suggestion {
  padding: 24rpx var(--cedh-space-4);
  color: var(--cedh-text);
  border-bottom: var(--cedh-hairline);
  font-size: var(--cedh-text-12);
  line-height: 1.35;
}

.suggestion:last-child {
  border-bottom: 0;
}

/* 技术仪表读数：超大等宽胜率英雄数字 + 支撑读数，段内大写 tracked 微标签 */
.stat-readout {
  display: flex;
  align-items: stretch;
  gap: var(--cedh-space-4);
  margin-top: var(--cedh-space-5);
  padding: var(--cedh-space-4);
  background: var(--cedh-surface-muted);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-1);
}

.stat-hero {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: var(--cedh-space-4);
  border-right: var(--cedh-hairline);
}

.stat-hero-value {
  color: var(--cedh-text);
  font-size: 88rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.stat-hero-meta {
  margin-top: 12rpx;
}

.stat-micro-label {
  display: block;
  color: rgba(var(--module-accent-rgb), 0.92);
  font-family: var(--cedh-font-mono);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.2em;
  line-height: 1.2;
  text-transform: uppercase;
}

.stat-micro-sub {
  display: block;
  margin-top: 3rpx;
  color: var(--cedh-text-faint);
  font-size: 18rpx;
  letter-spacing: 0.12em;
  line-height: 1.2;
}

.stat-secondary {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  flex-direction: column;
  justify-content: center;
  gap: var(--cedh-space-4);
}

.stat-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cedh-space-2);
}

.stat-line-value {
  color: var(--cedh-text);
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* 数值单行、标签两行 → 数值对齐标签块的垂直中线，避免贴到英文首行 */
.stat-line-meta {
  text-align: right;
}

.chart-section {
  position: relative;
  margin-top: var(--cedh-space-5);
}

.chart-title {
  position: relative;
  z-index: 1;
  margin-bottom: var(--cedh-space-2);
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  font-weight: 600;
  letter-spacing: 0.14em;
}

.chart-canvas {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 220rpx;
  overflow: hidden;
  background: var(--cedh-surface);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
}

.record-entry {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--cedh-space-3);
  margin-top: var(--cedh-space-5);
}

.record-row {
  display: grid;
}

.record-selectors {
  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) minmax(0, 0.72fr);
  gap: var(--cedh-space-2);
  width: 100%;
  min-width: 0;
}

.record-selectors picker {
  min-width: 0;
}

.record-select {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 76rpx;
  padding: 0 10rpx;
  overflow: hidden;
  color: var(--cedh-text);
  background: var(--cedh-input-glass);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-control-sm);
  font-size: var(--cedh-text-12);
  line-height: 1.18;
  white-space: nowrap;
}

.record-select-label {
  margin-bottom: 4rpx;
  color: var(--cedh-text-faint);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.record-select.win {
  color: var(--tracker-win);
  background: var(--tracker-win-soft);
  border-color: var(--tracker-win-line);
}

.record-select.loss {
  color: var(--tracker-loss);
  background: var(--tracker-loss-soft);
  border-color: var(--tracker-loss-line);
}

.record-select.draw {
  color: var(--tracker-draw);
  background: var(--tracker-draw-soft);
  border-color: var(--tracker-draw-line);
}

.record-select.seat1 {
  color: var(--tracker-seat-leaf-text-1);
  background: var(--tracker-seat-leaf-1);
  border-color: var(--tracker-seat-leaf-line-1);
}

.record-select.seat2 {
  color: var(--tracker-seat-leaf-text-2);
  background: var(--tracker-seat-leaf-2);
  border-color: var(--tracker-seat-leaf-line-2);
}

.record-select.seat3 {
  color: var(--tracker-seat-leaf-text-3);
  background: var(--tracker-seat-leaf-3);
  border-color: var(--tracker-seat-leaf-line-3);
}

.record-select.seat4 {
  color: var(--tracker-seat-leaf-text-4);
  background: var(--tracker-seat-leaf-4);
  border-color: var(--tracker-seat-leaf-line-4);
}

.record-actions {
  display: flex;
  align-items: center;
  gap: var(--cedh-space-3);
}

.add-match-button {
  flex: 1 1 auto;
  min-height: 82rpx;
  margin-top: var(--cedh-space-2);
}

.match-list {
  margin-top: var(--cedh-space-4);
  border-top: 1rpx solid rgba(255, 249, 224, 0.12);
}

.match-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.08em;
}

.match-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 104rpx 52rpx 88rpx;
  gap: var(--cedh-space-2);
  align-items: center;
  min-width: 0;
  min-height: 84rpx;
  border-bottom: 1rpx solid rgba(255, 249, 224, 0.1);
}

.match-row-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.match-action {
  display: flex;
  flex: 0 0 36rpx;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  color: var(--cedh-text-faint);
  border: 1rpx solid rgba(255, 249, 224, 0.12);
  border-radius: 50%;
  font-size: 18rpx;
  line-height: 1;
}

.match-action.match-delete {
  color: var(--cedh-danger);
  border-color: rgba(200, 76, 68, 0.22);
}

.match-identity {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.match-sequence {
  flex: 0 0 auto;
  color: var(--cedh-text-faint);
  font-size: 18rpx;
}

.match-date {
  min-width: 0;
  overflow: hidden;
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-12);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-seat {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 42rpx;
  padding: 0 10rpx;
  color: var(--cedh-text-faint);
  background: var(--cedh-surface-muted);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-pill);
  font-size: var(--cedh-text-10);
  line-height: 1.25;
  white-space: nowrap;
}

.match-result {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  border-radius: var(--cedh-radius-pill);
  text-align: center;
  color: var(--cedh-text);
  font-size: var(--cedh-text-12);
  font-weight: 700;
}

.match-result.win {
  color: var(--tracker-win);
  background: var(--tracker-win-soft);
}

.match-result.loss {
  color: var(--tracker-loss);
  background: var(--tracker-loss-soft);
}

.match-result.draw {
  color: var(--tracker-draw);
  background: var(--tracker-draw-soft);
}

.match-seat.seat1 {
  color: var(--tracker-seat-leaf-text-1);
  background: var(--tracker-seat-leaf-1);
  border-color: var(--tracker-seat-leaf-line-1);
}

.match-seat.seat2 {
  color: var(--tracker-seat-leaf-text-2);
  background: var(--tracker-seat-leaf-2);
  border-color: var(--tracker-seat-leaf-line-2);
}

.match-seat.seat3 {
  color: var(--tracker-seat-leaf-text-3);
  background: var(--tracker-seat-leaf-3);
  border-color: var(--tracker-seat-leaf-line-3);
}

.match-seat.seat4 {
  color: var(--tracker-seat-leaf-text-4);
  background: var(--tracker-seat-leaf-4);
  border-color: var(--tracker-seat-leaf-line-4);
}

.add-deck-button {
  min-height: 84rpx;
  font-size: var(--cedh-text-24);
  font-weight: 460;
}

.debug-actions {
  display: flex;
  align-items: stretch;
  gap: var(--cedh-space-3);
  width: 100%;
  min-width: 0;
  overflow: visible;
  padding-bottom: var(--cedh-space-3);
}

.debug-action-button {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  white-space: nowrap;
}

.tracker .add-match-button,
.tracker .add-deck-button,
.tracker .debug-action-button {
  color: var(--cedh-text);
  background: var(--cedh-input-glass);
  border: var(--cedh-hairline);
  box-shadow:
    0 12rpx 30rpx rgba(0, 0, 0, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

@media (max-width: 360px) {
  .match-row {
    grid-template-columns: minmax(0, 1fr) 88rpx 46rpx 84rpx;
  }

  .stat-readout {
    gap: var(--cedh-space-3);
    padding: var(--cedh-space-3);
  }

  .stat-hero-value {
    font-size: 76rpx;
  }

  .stat-line-value {
    font-size: 34rpx;
  }
}
