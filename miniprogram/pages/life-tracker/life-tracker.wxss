page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #020304;
}

.life-tracker-page {
  --life-entry-accent-rgb: 225, 93, 104;
  --life-entry-accent: #e15d68;
  /* 五人局右短边那条竖栏的宽度。20vw 在横屏各机型都够放下转 90 度的数字：
     844pt 宽机上是 169pt，667pt 宽机上是 133pt，而字号最大也就 85pt。 */
  --life-side-strip: 20vw;
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  color: #ffffff;
  background: #020304;
  font-family: var(--cedh-font-sans);
}

.life-grid {
  position: fixed;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* 两人上下对坐：单列两行，无竖线；三人上一下二：第一位横跨整行，竖线只画下半 */
.life-grid.mode-2 {
  grid-template-columns: 1fr;
}

.life-grid.mode-2::after {
  display: none;
}

.life-grid.mode-3 .player-zone.seat-1 {
  grid-column: 1 / -1;
}

.life-grid.mode-3::after {
  top: 50%;
  height: 50%;
}

/* 五人：左侧仍是四宫格，右短边留一条竖栏给第五个人——这是五个人围一台平放手机
   的真实坐法（两两对坐，一人坐短边）。五个座位全部显式落位：只给 seat-5 指定
   位置的话，自动流会把 seat-3 塞进第一行第三格，四宫格当场散架。 */
.life-grid.mode-5 {
  grid-template-columns: 1fr 1fr var(--life-side-strip);
}

.life-grid.mode-5 .player-zone.seat-1 { grid-area: 1 / 1; }
.life-grid.mode-5 .player-zone.seat-2 { grid-area: 1 / 2; }
.life-grid.mode-5 .player-zone.seat-3 { grid-area: 2 / 1; }
.life-grid.mode-5 .player-zone.seat-4 { grid-area: 2 / 2; }
.life-grid.mode-5 .player-zone.seat-5 { grid-area: 1 / 3 / 3 / 4; }

/* 分隔线跟着挪：横线只画到竖栏为止（竖栏是一个人，不该被横线切开），
   竖线落到四宫格真正的中缝上而不是屏幕中线。 */
.life-grid.mode-5::before {
  width: calc(100vw - var(--life-side-strip));
}

.life-grid.mode-5::after {
  left: calc(100vw - var(--life-side-strip));
}

/* 竖栏与四宫格之间那道线用内阴影而不是 border：::before/::after 两个伪元素都占满了，
   而 border 会挤占格子的内容区、把居中的数字推偏。 */
.life-grid.mode-5 .player-zone.seat-5 {
  box-shadow: inset 1rpx 0 0 rgba(var(--life-entry-accent-rgb), 0.11);
}

/* 中心菜单要回到四宫格真正的十字交点上，否则它偏在竖栏那侧，一眼就是没对齐 */
.life-grid.mode-5 .board-hub {
  left: calc((100vw - var(--life-side-strip)) / 2);
}

.life-grid::before,
.life-grid::after {
  content: "";
  position: absolute;
  z-index: 5;
  pointer-events: none;
  background: rgba(var(--life-entry-accent-rgb), 0.11);
  box-shadow: 0 0 10rpx rgba(var(--life-entry-accent-rgb), 0.04);
}

.life-grid::before {
  top: 50%;
  left: 0;
  width: 100%;
  height: 1rpx;
}

.life-grid::after {
  top: 0;
  left: 50%;
  width: 1rpx;
  height: 100%;
}

.player-zone {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 52%, rgba(var(--player-rgb), 0.19), rgba(var(--player-rgb), 0.05) 56%, rgba(2, 3, 4, 0.98) 100%);
}

.player-face {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-rows: repeat(2, 1fr);
  transform-origin: center;
}

.player-facing-top .player-face {
  transform: rotate(180deg);
}

.player-facing-bottom .player-face {
  transform: none;
}

/* 侧坐那位：加减区仍是两个轴对齐的矩形——左半加、右半减，从他的视角正好是上下。
   整块 face 转 90 度是行不通的：盒子还是竖栏那个瘦长尺寸，转完视觉宽高对调、必然溢出。
   所以只转数字那一块，并给它一个沿竖栏长边的显式宽度。 */
.player-facing-right .player-face {
  grid-template-rows: 1fr;
  grid-template-columns: repeat(2, 1fr);
}

.player-facing-right .life-increase {
  grid-row: 1;
  grid-column: 1;
}

.player-facing-right .life-decrease {
  grid-row: 1;
  grid-column: 2;
}

/* -90 度而不是 90 度：他坐在右边朝屏幕左侧看，所以他的「上」是屏幕的负 x 方向。
   转 +90 度的话数字对他是倒着的。 */
.player-facing-right .player-summary {
  width: 80vh;
  transform: translate(-50%, -50%) rotate(-90deg);
}

/* 边缘赛跑：每个座位在自己那条屏幕外缘上有一段线，光按围坐顺序跑过它们。
   位置直接跟着朝向类走——一个人坐哪条边，他的线就在哪条边，两者本来就是同一件事。

   为什么是光不是文字：一半座位转了 180 度，任何一句「你先手」对另一半都是倒的。
   为什么不做成聚光：本页的径向渐变配额只有一个，已经给了玩家分区光晕（发布门禁会数），
   所以这里只用纯色 + 外发光。注释里也不要写那个字面量——本仓的门禁连注释一起扫。 */
.seat-edge {
  position: absolute;
  z-index: 4;
  background: rgb(var(--player-rgb));
  opacity: 0;
  /* 140ms 比最快那一档（55ms）还长，所以快段根本来不及亮到满——
     于是「转得快时发虚、慢下来才逐渐结实」是自然长出来的，不用另写一套。 */
  transition: opacity 140ms ease-out, box-shadow 140ms ease-out;
  pointer-events: none;
}

.player-facing-top .seat-edge {
  top: 0;
  left: 0;
  width: 100%;
  height: 3rpx;
}

.player-facing-bottom .seat-edge {
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3rpx;
}

.player-facing-right .seat-edge {
  top: 0;
  right: 0;
  width: 3rpx;
  height: 100%;
}

/* 彗尾三档。外发光只给头部：全都发光就糊成一圈，看不出光在往哪边跑。 */
.seat-edge.level-1 {
  opacity: 0.2;
}

.seat-edge.level-2 {
  opacity: 0.52;
}

.seat-edge.level-3 {
  opacity: 1;
  box-shadow:
    0 0 12rpx rgba(var(--player-rgb), 0.85),
    0 0 30rpx rgba(var(--player-rgb), 0.42);
}

/* 落定后常驻：中签者那条边一直留着他的颜色。
   比头部收敛得多——它要陪完整整一局，不能一直在抢注意力。 */
.seat-edge.seat-edge-won {
  opacity: 0.9;
  box-shadow: 0 0 8rpx rgba(var(--player-rgb), 0.45);
}

.hub-draw {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.4);
}

.life-hit-area {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  user-select: none;
}

.life-increase {
  grid-row: 1;
}

.life-decrease {
  grid-row: 2;
}

.life-hit-active {
  background: rgba(var(--player-rgb), 0.14);
}

.player-summary {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  width: 72%;
  text-align: center;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.life-value {
  color: #ffffff;
  font-family: "cEDHDisplay", "Arial Black", "Avenir Next Condensed", "DIN Condensed", Impact, sans-serif;
  font-size: 21vh;
  font-size: clamp(76rpx, 21vh, 180rpx);
  font-style: italic;
  font-weight: 900;
  letter-spacing: -0.07em;
  line-height: 0.82;
  text-shadow:
    -1rpx -1rpx 0 var(--player-color),
    1rpx 1rpx 0 var(--player-color),
    0 0 10rpx rgba(var(--player-rgb), 0.62),
    0 0 28rpx rgba(var(--player-rgb), 0.24);
  pointer-events: none;
}

.board-hub {
  position: fixed;
  top: 50vh;
  left: 50vw;
  z-index: 8;
  width: 0;
  height: 0;
}

/* 透明热区：视觉胶囊保持 36×28rpx，可点区域扩到 88×88rpx（44pt 标准） */
.hub-trigger-hit {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}

.dropdown-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 28rpx;
  color: rgba(var(--life-entry-accent-rgb), 0.72);
  background: rgba(2, 3, 4, 0.97);
  border: 1rpx solid rgba(var(--life-entry-accent-rgb), 0.56);
  border-radius: 999rpx;
  box-shadow:
    0 0 4rpx rgba(var(--life-entry-accent-rgb), 0.16),
    0 0 8rpx rgba(0, 0, 0, 0.66);
  animation: dropdown-rgb-cycle 12s ease-in-out infinite;
}

.hub-trigger-hit-active .dropdown-trigger {
  color: #ffffff;
  filter: brightness(1.28);
}

@keyframes dropdown-rgb-cycle {
  0%, 100% {
    color: rgba(var(--life-entry-accent-rgb), 0.72);
    border-color: rgba(var(--life-entry-accent-rgb), 0.56);
    box-shadow: 0 0 4rpx rgba(var(--life-entry-accent-rgb), 0.16), 0 0 8rpx rgba(0, 0, 0, 0.66);
  }

  33% {
    color: rgba(104, 218, 143, 0.72);
    border-color: rgba(104, 218, 143, 0.56);
    box-shadow: 0 0 4rpx rgba(104, 218, 143, 0.16), 0 0 8rpx rgba(0, 0, 0, 0.66);
  }

  66% {
    color: rgba(102, 190, 255, 0.74);
    border-color: rgba(102, 190, 255, 0.58);
    box-shadow: 0 0 4rpx rgba(102, 190, 255, 0.17), 0 0 8rpx rgba(0, 0, 0, 0.66);
  }
}

.dropdown-icon {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  width: 15rpx;
  transform: scaleX(1);
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

.dropdown-open .dropdown-icon {
  transform: scaleX(0.72);
}

.dropdown-bar {
  width: 100%;
  height: 1rpx;
  background: currentColor;
  border-radius: 999rpx;
  box-shadow: 0 0 3rpx currentColor;
}

.dropdown-menu {
  position: absolute;
  top: 48rpx;
  left: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  /* 220 而不是 180：人数那行从三颗变四颗，每颗净宽 (220-3*6)/4 = 50.5rpx，
     「5人」两字在 16rpx 字号下约 32rpx，还留得下呼吸 */
  width: 220rpx;
  padding: 0;
  visibility: hidden;
  opacity: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  transform: translate(-50%, -7rpx) scale(0.92);
  transform-origin: top center;
  pointer-events: none;
  transition:
    opacity 160ms ease,
    transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
    visibility 0ms linear 200ms;
}

.dropdown-menu-open {
  visibility: visible;
  opacity: 1;
  transform: translate(-50%, 0) scale(1);
  pointer-events: auto;
  transition-delay: 0ms;
}

.hub-row {
  display: flex;
  gap: 6rpx;
  justify-content: center;
}

.hub-action {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 44rpx;
  min-width: 0;
  min-height: 0;
  padding: 0;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(2, 3, 4, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.hub-reset {
  color: #ffd0d4;
  border-color: rgba(var(--life-entry-accent-rgb), 0.34);
}

.hub-mode-active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.66);
}

.hub-action-active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

/* 本页锁横屏：rpx 由「宽」推导，而横屏下宽是长边，所以 rpx 相对视口高度会很大——
   不能用 50vh + Nrpx 这类混算做纵向定位（150rpx 在横屏约 162pt，直接把条推出屏幕底部）。
   中心菜单向下展开、横屏下已到约 91vh，下方没有空间；顶部是唯一稳定的空区，直接贴顶。 */
.undo-bar {
  position: fixed;
  top: calc(16rpx + constant(safe-area-inset-top));
  top: calc(16rpx + env(safe-area-inset-top));
  left: 50vw;
  z-index: 9;
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 胶囊套胶囊要同心：内缩必须四面一致，否则圆角看着就是没对齐。
     56 - 44 = 12，上下各 6rpx，故右侧也取 6rpx（左侧是文字侧，不受此约束） */
  height: 56rpx;
  padding: 0 6rpx 0 20rpx;
  background: rgba(2, 3, 4, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  transform: translate(-50%, 0);
  white-space: nowrap;
}

.undo-text {
  color: rgba(255, 255, 255, 0.82);
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
}

/* 撤销是这条里唯一的动作，给实心白最高对比；热区 88rpx 宽与中心触发器同口径 */
.undo-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 44rpx;
  padding: 0 16rpx;
  color: #0a0a0a;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.undo-action-active {
  background: rgba(255, 255, 255, 0.68);
}

@media (prefers-reduced-motion: reduce) {
  .dropdown-trigger {
    animation: none;
  }

  /* 赛跑本身停不掉——小程序没有让 JS 读到这条媒体查询的 API，硬跳过就变成
     对着三秒空屏发呆。能做的是去掉发光和过渡，只留最朴素的亮/灭。
     被切换的是一条 3rpx 发丝线，面积远在 WCAG 2.3.1 的小面积豁免之内，
     而且变的是不透明度不是位移，不触发前庭反应。 */
  .seat-edge {
    transition: none;
  }

  .seat-edge.level-3,
  .seat-edge.seat-edge-won {
    box-shadow: none;
  }

  .dropdown-icon,
  .dropdown-menu {
    transition-duration: 0ms;
  }
}

@media (max-height: 390px) {
  .life-value {
    font-size: 19vh;
    font-size: clamp(66rpx, 19vh, 150rpx);
  }
}
