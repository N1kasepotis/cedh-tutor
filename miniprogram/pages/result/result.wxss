@import "../../styles/themes/noir-gold.wxss";

/* 卡图点按反馈：只调透明度，不位移不缩放 */
.art-tap-active {
  opacity: 0.78;
}

.result-shell {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-6);
}

.result-title {
  color: var(--cedh-text);
  font-family: var(--cedh-font-serif);
  font-size: var(--cedh-text-30);
  font-weight: 400;
  letter-spacing: -0.035em;
  line-height: 1.04;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: var(--cedh-space-3);
}

.recommend-card {
  position: relative;
  min-height: 224rpx;
  overflow: hidden;
  padding: var(--cedh-space-5);
  background: rgba(10, 10, 9, 0.78);
  border-color: rgba(var(--noir-gold-rgb), 0.24);
  box-shadow:
    inset 0 1rpx 0 rgba(var(--noir-candle-rgb), 0.08),
    0 22rpx 62rpx rgba(0, 0, 0, 0.36);
}

.recommend-card.top-match {
  min-height: 260rpx;
  border-color: rgba(var(--noir-gold-rgb), 0.48);
  box-shadow:
    0 28rpx 78rpx rgba(0, 0, 0, 0.48),
    inset 0 1rpx 0 rgba(var(--noir-candle-rgb), 0.16);
}

.banner-art {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 46%;
  opacity: 1;
  overflow: hidden;
  pointer-events: auto;
}

.banner-art-left {
  left: 0;
}

.banner-art-right {
  right: 0;
}

.banner-art-center {
  left: 50%;
  width: 100%;
  transform: translateX(-50%);
}

.dual-preview .banner-art-left {
  width: 50%;
}

.dual-preview .banner-art-right {
  width: 50%;
}

.banner-art-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 18%;
  filter: none;
}

/* 卡图加载中 / 加载失败时的主题色占位底纹 */
.banner-art-placeholder {
  width: 100%;
  height: 100%;
  background:
    linear-gradient(135deg, rgba(var(--noir-gold-rgb), 0.1), rgba(10, 10, 9, 0.6) 62%, rgba(var(--noir-gold-rgb), 0.05));
}

/* 底部 scrim：保证叠在明亮卡图上的卡名与契合度文字可读 */
.banner-art::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.5) 100%);
}

.dual-preview .banner-art-image {
  height: 116%;
  transform-origin: center top;
}

.single-preview .banner-art-center .banner-art-image {
  height: 124%;
  object-position: center 12%;
  transform: translateY(0);
  transform-origin: center top;
}

.recommend-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 136rpx;
  padding: var(--cedh-space-1) var(--cedh-space-3) 0;
  text-align: center;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  text-shadow:
    0 2rpx 0 rgba(0, 0, 0, 0.72),
    0 10rpx 26rpx rgba(0, 0, 0, 0.82);
}

.top-match .recommend-content {
  min-height: 166rpx;
}

.recommend-kicker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--cedh-space-2);
}

.recommend-rank {
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  letter-spacing: 0.14em;
}

.top-match-badge {
  padding: 6rpx 14rpx;
  color: #f7e6ba;
  font-size: var(--cedh-text-10);
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.2;
  background: rgba(0, 0, 0, 0.58);
  border: 1rpx solid rgba(var(--noir-aged-gold-rgb), 0.46);
  border-radius: 999rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.recommend-name {
  width: 100%;
  margin-top: var(--cedh-space-3);
  color: #fff4cf;
  font-family: var(--cedh-font-serif);
  font-size: var(--cedh-text-20);
  font-weight: 520;
  letter-spacing: -0.02em;
  line-height: 1.22;
  white-space: normal;
  overflow: visible;
  word-break: break-word;
}

.recommend-name-stacked {
  margin-top: var(--cedh-space-2);
  font-size: var(--cedh-text-24);
  line-height: 1.05;
}

.recommend-name-line {
  display: block;
}

.link-button {
  position: relative;
  z-index: 2;
  margin-top: var(--cedh-space-4);
  min-height: 78rpx;
  color: #f7e6ba;
  background: rgba(0, 0, 0, 0.68);
  border-color: rgba(var(--noir-aged-gold-rgb), 0.44);
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.image-credit {
  margin-top: calc(var(--cedh-space-2) * -1);
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  line-height: 1.45;
  text-align: center;
}

.actions {
  display: flex;
  align-items: stretch;
  gap: var(--cedh-space-3);
  width: 100%;
  min-width: 0;
  overflow: visible;
  padding-bottom: 10rpx;
}

.action-button {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  padding: 0 var(--cedh-space-2);
  font-size: var(--cedh-text-10);
  white-space: nowrap;
}

@media (max-width: 360px) {
  .recommend-card {
    padding: var(--cedh-space-4);
  }

  .recommend-name {
    font-size: var(--cedh-text-18);
  }
}
