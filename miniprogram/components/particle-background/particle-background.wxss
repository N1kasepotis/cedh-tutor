.particle-canvas {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  background: transparent;
}

/* 弹层打开时只隐藏，不用 wx:if：节点和绘图上下文留着，关闭后不必重新初始化。 */
.particle-canvas.is-paused {
  visibility: hidden;
}

/* Canvas 动画无法从 JS 侧感知系统减弱动效设置，直接隐藏画布 */
@media (prefers-reduced-motion: reduce) {
  .particle-canvas {
    display: none;
  }
}
