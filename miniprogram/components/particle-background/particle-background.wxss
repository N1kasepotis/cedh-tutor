.particle-canvas {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  background: transparent;
}

/* 弹层打开时只隐藏，不用 wx:if：节点和绘图上下文留着，关闭后不必重新初始化。 */
.particle-canvas.is-paused {
  visibility: hidden;
}

/* 系统减弱动效时隐藏画布。组件初始化时读到这里的 display:none，就不再启动帧循环 */
@media (prefers-reduced-motion: reduce) {
  .particle-canvas {
    display: none;
  }
}
