@import "./styles/tokens.wxss";

page {
  min-height: 100%;
  color: var(--cedh-text);
  background: linear-gradient(180deg, #fffefa 0%, #ffffff 48%, #f8f5ee 100%);
  font-family: var(--cedh-font-sans);
  font-size: var(--cedh-text-14);
}

view,
text,
button,
input,
textarea,
canvas {
  box-sizing: border-box;
}

button {
  padding: 0;
  border: 0;
  border-radius: var(--cedh-radius-control);
  font-family: var(--cedh-font-sans);
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + var(--cedh-space-7)) var(--cedh-page-x) calc(env(safe-area-inset-bottom) + var(--cedh-space-7));
  overflow: hidden;
}

.content-layer {
  position: relative;
  z-index: 2;
}

.mono {
  font-family: var(--cedh-font-mono);
}

.surface {
  background: var(--cedh-surface);
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
  box-shadow: var(--cedh-shadow-soft);
}

/* 空状态：标题 + 说明 + 行动按钮，各页复用（配 .surface 使用） */
.empty {
  padding: var(--cedh-space-6);
}

.empty-title {
  color: var(--cedh-text);
  font-family: var(--cedh-font-serif);
  font-size: var(--cedh-text-24);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.18;
}

.empty-text {
  margin: var(--cedh-space-3) 0 var(--cedh-space-5);
  color: var(--cedh-text-soft);
  font-size: var(--cedh-text-14);
  line-height: 1.55;
}

/* 按钮的配色/描边/阴影统一由 --cedh-btn-* 变量驱动，各页主题在 styles/themes/ 覆盖；
   var() 的第二参数是浅色默认主题。 */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  color: var(--cedh-btn-primary-color, #fffefa);
  background: var(--cedh-btn-primary-bg, linear-gradient(135deg, rgba(28, 23, 19, 0.92) 0%, rgba(95, 33, 27, 0.84) 52%, rgba(155, 58, 47, 0.76) 100%));
  border: var(--cedh-btn-primary-border, 1rpx solid rgba(95, 33, 27, 0.76));
  box-shadow: var(--cedh-btn-primary-shadow, 0 22rpx 48rpx rgba(95, 33, 27, 0.18), inset 0 1rpx 0 rgba(255, 254, 250, 0.24));
  border-radius: var(--cedh-radius-control);
  font-size: var(--cedh-text-12);
  font-weight: 600;
  letter-spacing: 0.12em;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  color: var(--cedh-btn-secondary-color, var(--cedh-text));
  background: var(--cedh-btn-secondary-bg, rgba(255, 254, 250, 0.66));
  border: var(--cedh-btn-secondary-border, 1rpx solid rgba(177, 139, 82, 0.24));
  box-shadow: var(--cedh-btn-secondary-shadow, 0 14rpx 34rpx rgba(54, 42, 31, 0.055), inset 0 1rpx 0 rgba(255, 255, 255, 0.78));
  border-radius: var(--cedh-radius-control);
  font-size: var(--cedh-text-12);
  font-weight: 560;
  letter-spacing: 0.08em;
}

.primary-button,
.secondary-button,
.text-button,
.option,
.preset-chip,
.result-button,
.seat-button {
  border-radius: var(--cedh-radius-control-sm);
  transform: translateY(0);
  transition:
    transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
    opacity 220ms ease,
    box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform, opacity;
}

.pressable-active {
  opacity: 0.72;
  transform: translateY(6rpx);
}

.primary-button.drawing,
.secondary-button.drawing {
  opacity: 0.72;
  transform: translateY(6rpx);
}

button[disabled] {
  color: var(--cedh-text-faint);
  background: var(--cedh-surface-muted);
  border-color: var(--cedh-line);
  box-shadow: none;
}

button[disabled].pressable-active,
.disabled.pressable-active {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .primary-button,
  .secondary-button,
  .text-button,
  .option,
  .preset-chip,
  .result-button,
  .seat-button {
    transition: opacity 120ms ease;
  }

  .pressable-active,
  .primary-button.drawing,
  .secondary-button.drawing {
    transform: none;
  }
}

/* ===== 卡图署名 =====
   凡是渲染 Scryfall 卡图的页面都必须带这一行。这不是装饰：卡面美术的版权属于
   Wizards of the Coast 与画师，Scryfall 只是图源；缺署名在商用语境下是实打实的风险。
   此前只有结算页写了，其余五个渲染卡图的页面（强度分级 / 人格测试 / 套牌试玩 /
   我的主将 / 环境梯度）都漏了，shared.suite 现按「模板里出现卡图就必须出现署名」逐页校验。
   样式走既有 token，不新增视觉语汇：最faint 的文字色 + 10px，安静地待在内容末尾。 */
.card-art-credit {
  padding: 0 var(--cedh-space-3);
  color: var(--cedh-text-faint);
  font-size: var(--cedh-text-10);
  line-height: 1.45;
  text-align: center;
}
