<view class="studio poll-panel">
  <view class="section-title">你怎么选</view>
  <view class="actions">
    <button
      hover-class="pressable-active"
      wx:for="{{choices}}"
      wx:key="id"
      class="{{localChoice === item.id ? 'chosen' : ''}}"
      data-choice="{{item.id}}"
      bindtap="choose"
      disabled="{{busy}}"
    >
      {{item.label}}
    </button>
  </view>
  <block wx:if="{{!compact && !closed}}">
    <button hover-class="pressable-active" class="link" bindtap="toggleDetails">
      {{details ? '收起补充信息' : '补充投票信息（选填）'}}
    </button>
    <view wx:if="{{details}}" class="row wrap">
      <picker
        range="{{perspectives}}"
        value="{{perspective}}"
        bindchange="perspective"
        disabled="{{busy}}"
      >
        <view class="notice">平时玩：{{perspectives[perspective]}} ▾</view>
      </picker>
      <picker
        range="{{reasons}}"
        value="{{reason}}"
        bindchange="reason"
        disabled="{{busy}}"
      >
        <view class="notice">理由：{{reasons[reason]}} ▾</view>
      </picker>
    </view>
  </block>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!compact && !closed}}" class="actions">
    <button
      hover-class="pressable-active"
      class="primary"
      bindtap="submit"
      disabled="{{busy || !localChoice || !online}}"
      loading="{{busy}}"
    >
      {{mine ? '改票' : '投票'}}
    </button>
    <button
      hover-class="pressable-active"
      wx:if="{{mine}}"
      bindtap="retract"
      disabled="{{busy}}"
    >
      撤票
    </button>
  </view>
  <view wx:if="{{!compact && !online}}" class="notice">当前无法连接投票服务，可先保存选择</view>
  <view wx:if="{{!compact && online && closed}}" class="notice">这一轮投票暂未开放，可先保存选择</view>
  <view wx:if="{{stats && (!compact || localChoice)}}" class="section">
    <view class="row between">
      <text class="section-title">牌手投票</text>
      <picker wx:if="{{!compact}}" range="{{views}}" value="{{view}}" bindchange="filter">
        <view class="notice">{{views[view]}} ▾</view>
      </picker>
    </view>
    <view class="metadata muted">
      <text>{{sample}} 人参与</text>
      <text wx:if="{{!compact}}">{{unknown}} 人未表态</text>
    </view>
    <view wx:for="{{rows}}" wx:key="id" class="list-item">
      <view class="row between">
        <text>{{item.label}}</text>
        <text class="vote-count">{{item.count}} 票{{known ? ' / ' + item.percent + '%' : ''}}</text>
      </view>
      <view class="bar-track">
        <view class="bar-fill" style="width:{{item.percent}}%" />
      </view>
    </view>
    <view wx:if="{{!compact}}" class="credit">比例不计入未表态票</view>
  </view>
  <button
    hover-class="pressable-active"
    wx:if="{{online && !compact && !closed}}"
    class="link"
    bindtap="refresh"
    disabled="{{busy}}"
  >
    刷新票数
  </button>
</view>
