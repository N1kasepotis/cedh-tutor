@import "../styles/themes/dark-table.wxss";
page {
  background: #070707;
  color: #fffefa;
}
.studio {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(165deg, #161015 0, #070707 42%, #020202 100%);
  color: #fffefa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
.studio view,
.studio text,
.studio input,
.studio textarea {
  box-sizing: border-box;
}
.eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #e5bad3;
  margin-bottom: 20rpx;
}
.title {
  display: block;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
  margin: 0 0 20rpx;
  overflow-wrap: anywhere;
}
.subtitle,
.muted {
  color: rgba(255, 254, 250, 0.68);
  font-size: 26rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.section {
  margin-top: 42rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.panel {
  background: rgba(255, 255, 255, 0.065);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  min-width: 0;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.wrap {
  flex-wrap: wrap;
}
.studio button:not([size="mini"]),
.picker-shell button:not([size="mini"]) {
  width: auto;
  min-width: 0;
  margin: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fffefa;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}
.studio button::after,
.picker-shell button::after {
  border: 0;
}
.studio button.primary {
  background: #be709e;
  border-color: #be709e;
  color: #100a0e;
}
.studio button.chosen {
  color: #e5bad3;
  border-color: #be709e;
  background: rgba(190, 112, 158, 0.18);
}
.studio button[disabled]:not([type]),
.studio button[disabled]:not([size="mini"]),
.picker-shell button[disabled]:not([size="mini"]) {
  color: rgba(255, 254, 250, 0.45);
  background: #242024;
  opacity: 1;
  border-color: rgba(255, 255, 255, 0.12);
}
.studio button:focus-visible {
  outline: 2px solid #e5bad3;
  outline-offset: 3px;
}
.studio button.link:not([size="mini"]) {
  background: transparent;
  border-color: transparent;
  color: #e5bad3;
  padding-left: 0;
  padding-right: 0;
  justify-content: flex-start;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.actions button {
  flex: 1 1 180rpx;
}
.studio input,
.studio textarea,
.picker-shell input {
  width: 100%;
  min-height: 92rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  background: #171417;
  color: #fffefa;
  font-size: 28rpx;
  line-height: 1.5;
  margin: 12rpx 0 20rpx;
}
.studio textarea {
  height: 160rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #e5bad3;
  margin-top: 24rpx;
  margin-bottom: 10rpx;
}
.error {
  background: #392127;
  border-left: 4rpx solid #df91a2;
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
  margin: 24rpx 0;
  overflow-wrap: anywhere;
}
.notice {
  padding: 20rpx 0;
  color: #e5bad3;
  font-size: 25rpx;
  line-height: 1.6;
}
.empty {
  padding: 48rpx 16rpx;
  text-align: center;
  color: rgba(255, 254, 250, 0.68);
  font-size: 28rpx;
  line-height: 1.7;
}
.credit {
  margin-top: 40rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: rgba(255, 254, 250, 0.46);
}
.rule {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.14);
  margin: 30rpx 0;
}
.badge {
  font-size: 22rpx;
  color: #e5bad3;
  border: 1rpx solid rgba(190, 112, 158, 0.4);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  flex-shrink: 0;
}
.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}
.card-name {
  font-size: 29rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.image-card {
  width: 100%;
  height: 780rpx;
  display: block;
  background: #1b181c;
  border-radius: 16rpx;
}
.thumb {
  width: 108rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #252025;
}
.number {
  font-size: 50rpx;
  color: #e5bad3;
  font-weight: 600;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.82);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal-sheet {
  max-height: 85vh;
  width: 100%;
  background: #151315;
  padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}
@media (max-width: 350px) {
  .studio {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .title {
    font-size: 50rpx;
  }
  .panel {
    padding: 22rpx;
  }
}
