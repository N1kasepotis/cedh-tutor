@import '../styles/themes/dark-table.wxss';
page {
  background: #070707;
  color: #fffefa;
}
.studio {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #070707 0%, #020202 58%, #000 100%);
  font-weight: 400;
  color: #fffefa;
  font-family: var(--cedh-font-sans);
}
.studio view,
.studio text,
.studio input,
.studio textarea {
  box-sizing: border-box;
}
.eyebrow {
  display: block;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--cedh-accent-ink);
  margin-bottom: 20rpx;
}
.title {
  display: block;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
  margin: 0 0 20rpx;
  overflow-wrap: anywhere;
}
.subtitle,
.muted {
  color: var(--cedh-text-soft);
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.section {
  margin-top: 42rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.panel {
  background: var(--cedh-surface);
  border: 1rpx solid var(--cedh-line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  min-width: 0;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.wrap {
  flex-wrap: wrap;
}
.studio button:not([size='mini']),
.picker-shell button:not([size='mini']) {
  width: auto;
  min-width: 44px;
  margin: 0;
  border: var(--cedh-btn-secondary-border);
  border-radius: var(--cedh-radius-control-sm);
  padding: 20rpx 24rpx;
  background: var(--cedh-btn-secondary-bg);
  color: var(--cedh-btn-secondary-color);
  box-shadow: var(--cedh-btn-secondary-shadow);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  min-height: 88rpx;
  min-height: max(44px, 88rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}
.studio button::after,
.picker-shell button::after {
  border: 0;
}
.studio button.primary {
  background: var(--cedh-btn-primary-bg);
  border: var(--cedh-btn-primary-border);
  color: var(--cedh-btn-primary-color);
  box-shadow: var(--cedh-btn-primary-shadow);
}
.studio button.chosen {
  color: var(--cedh-accent-ink);
  border-color: var(--cedh-accent);
  background: var(--cedh-accent-soft);
}
.studio button[disabled]:not([type]),
.studio button[disabled]:not([size='mini']),
.picker-shell button[disabled]:not([size='mini']) {
  color: rgba(255, 254, 250, 0.45);
  background: var(--cedh-disabled-bg);
  opacity: 1;
  border-color: rgba(255, 255, 255, 0.12);
}
.studio button:focus-visible {
  outline: 2px solid var(--cedh-accent-ink);
  outline-offset: 3px;
}
.studio button.link:not([size='mini']) {
  background: transparent;
  border-color: transparent;
  color: var(--cedh-accent-ink);
  padding-left: 0;
  padding-right: 0;
  justify-content: flex-start;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.actions button {
  flex: 1 1 180rpx;
}
.studio input,
.studio textarea,
.picker-shell input {
  width: 100%;
  min-height: 92rpx;
  padding: 22rpx;
  border: var(--cedh-hairline);
  border-radius: var(--cedh-radius-2);
  background: var(--cedh-input-glass);
  color: #fffefa;
  font-size: 28rpx;
  line-height: 1.5;
  margin: 12rpx 0 20rpx;
}
.studio textarea {
  height: 160rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: var(--cedh-accent-ink);
  margin-top: 24rpx;
  margin-bottom: 10rpx;
}
.error {
  background: var(--cedh-danger-soft);
  border-left: 4rpx solid var(--cedh-danger);
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
  margin: 24rpx 0;
  overflow-wrap: anywhere;
}
.notice {
  padding: 20rpx 0;
  color: var(--cedh-accent-ink);
  font-size: 25rpx;
  line-height: 1.6;
}
.empty {
  padding: 48rpx 16rpx;
  text-align: center;
  color: var(--cedh-text-soft);
  font-size: 28rpx;
  line-height: 1.7;
}
.credit {
  margin-top: 40rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--cedh-text-credit);
}
.rule {
  height: 1rpx;
  background: var(--cedh-line);
  margin: 30rpx 0;
}
.badge {
  font-size: 22rpx;
  color: var(--cedh-accent-ink);
  border: 1rpx solid var(--cedh-accent-line);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  flex-shrink: 0;
}
.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}
.card-name {
  font-size: 29rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.image-card {
  width: 100%;
  height: 780rpx;
  display: block;
  background: var(--cedh-surface);
  border-radius: 16rpx;
}
.thumb {
  width: 108rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: var(--cedh-surface-raised);
}
.number {
  font-size: 50rpx;
  color: var(--cedh-accent-ink);
  font-weight: 600;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.82);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal-sheet {
  max-height: 85vh;
  width: 100%;
  background: var(--cedh-surface-solid);
  padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}
@media (max-width: 350px) {
  .studio {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .title {
    font-size: 50rpx;
  }
  .panel {
    padding: 22rpx;
  }
}

.page-heading {
  padding-bottom: 12rpx;
}
.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 44rpx 0 22rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.metadata {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

/* Small-screen text keeps a readable floor instead of shrinking with rpx. */
.eyebrow,
.badge,
.credit {
  font-size: 12px;
}
.subtitle,
.muted,
.notice,
.label {
  font-size: 14px;
}
.studio input,
.studio textarea,
.picker-shell input {
  font-size: 16px;
}
.studio button:not([size='mini']),
.picker-shell button:not([size='mini']) {
  font-size: 14px;
}

.studio image,
.picker-shell image {
  background-color: var(--cedh-image-placeholder);
}
.studio picker > view,
.picker-shell picker > view {
  min-height: 44px;
  display: flex;
  align-items: center;
}
.studio picker,
.picker-shell picker {
  min-width: 44px;
}
.studio .eyebrow {
  font-family: var(--cedh-font-mono);
}
.studio button.link {
  box-shadow: none;
}
.studio .number,
.poll-panel .vote-count {
  font-family: var(--cedh-font-mono);
  font-variant-numeric: tabular-nums;
}
/* 撤回分享链接这类少用、会让旧链接失效的操作：仍是文字链接，颜色降到次要文字，不和主操作抢眼 */
.studio button.link.quiet-link:not([size='mini']) {
  color: var(--cedh-text-soft);
}
/* 少用的功能统一放在页面或区块最下方并居中：外层 flex 居中，按钮只占文字宽度，滑到底时不容易误触 */
.quiet-footer {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}
.studio .quiet-footer button.link:not([size='mini']) {
  padding-left: 24rpx;
  padding-right: 24rpx;
  font-size: 13px;
  font-weight: 400;
}
.panel .quiet-footer {
  margin-top: 8rpx;
}
