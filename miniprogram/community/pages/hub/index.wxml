<view class="studio hub">
  <view class="page-heading">
    <text class="eyebrow">EDH / COMMANDER</text>
    <text class="title">EDH 牌桌</text>
    <view class="subtitle">选牌 组牌 开局</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button
    hover-class="pressable-active"
    class="portrait-entry"
    data-id="passport"
    bindtap="open"
  >
    <view class="portrait-entry-head">
      <text class="badge">我的三张牌</text>
      <text class="entry-arrow">↗</text>
    </view>
    <view class="entry-cards" aria-hidden="true">
      <image
        lazy-load
        wx:for="{{coverCards}}"
        wx:key="printId"
        src="{{item.image}}"
        mode="aspectFit"
        class="entry-card entry-card-{{index}}"
      />
    </view>
    <view class="feature-title">三张牌认识你</view>
    <view class="feature-copy">最喜欢的设计　代表打法的牌　常用妙妙牌</view>
    <view class="feature-action">
      {{saved ? '编辑我的名片' : '选出我的三张牌'}}
      <text>→</text>
    </view>
  </button>
  <view class="section-heading">
    <text>牌桌工具</text>
    <text class="muted">开局前与收牌后</text>
  </view>
  <view class="tool-grid">
    <button
      hover-class="pressable-active"
      wx:for="{{entries}}"
      wx:key="id"
      class="tool-entry"
      data-id="{{item.id}}"
      bindtap="open"
    >
      <view class="tool-top">
        <text class="tool-label">{{item.tag}}</text>
        <text class="entry-arrow">↗</text>
      </view>
      <view class="entry-title">{{item.title}}</view>
      <view class="muted">{{item.description}}</view>
    </button>
  </view>
  <button hover-class="pressable-active" class="review-entry" bindtap="tracker">
    <view class="grow">
      <view class="entry-title">对局复盘</view>
      <view class="muted">记下关键回合和下次调整</view>
    </view>
    <text class="entry-arrow">→</text>
  </button>
  <view wx:if="{{pending}}" class="notice">{{pending}} 条调牌记录待复盘</view>
  <view class="credit">
    <view>草稿与战绩保存在本机</view>
    <view>投票和分享需手动提交</view>
  </view>
</view>
