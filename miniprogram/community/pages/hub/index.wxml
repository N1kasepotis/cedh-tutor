<view class="studio hub">
  <particle-background palette="tracker"></particle-background>
  <view class="content-layer">
    <view class="page-heading">
      <text class="title">EDH hub</text>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button
      hover-class="pressable-active"
      class="portrait-entry"
      data-id="passport"
      bindtap="open"
      aria-label="我的三张牌"
    >
      <view class="portrait-entry-head">
        <text class="badge">我的三张牌</text>
        <text class="entry-arrow" aria-hidden="true">›</text>
      </view>
      <view class="entry-cards" aria-hidden="true">
        <image
          lazy-load
          wx:for="{{coverCards}}"
          wx:key="printId"
          src="{{item.image}}"
          mode="aspectFit"
          class="entry-card entry-card-{{index}}"
        />
      </view>
    </button>
    <view class="section-heading">
      <text>牌桌工具</text>
    </view>
    <view class="tool-grid">
      <button
        hover-class="pressable-active"
        wx:for="{{entries}}"
        wx:key="id"
        class="tool-entry"
        data-id="{{item.id}}"
        bindtap="open"
      >
        <view class="tool-top">
          <text class="tool-label">{{item.tag}}</text>
          <text class="entry-arrow" aria-hidden="true">›</text>
        </view>
        <view class="entry-title">{{item.title}}</view>
        <view class="muted">{{item.description}}</view>
      </button>
    </view>
    <view wx:if="{{pending}}" class="notice">{{pending}} 条调牌记录待复盘</view>
  </view>
</view>
