@import "../../styles.wxss";
.hub-title {
  font-size: 66rpx;
  line-height: 1.3;
}
.hub-stats {
  display: flex;
  gap: 44rpx;
  padding: 36rpx 0;
}
.studio button.hub-entry {
  display: flex;
  width: 100%;
  text-align: left;
  gap: 24rpx;
  justify-content: flex-start;
  background: transparent;
  border: 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 0;
  padding: 34rpx 0;
}
.entry-number {
  font-size: 22rpx;
  color: #e5bad3;
  align-self: flex-start;
  margin-top: 8rpx;
}
.entry-title {
  font-size: 36rpx;
  margin-bottom: 10rpx;
  line-height: 1.4;
}
.entry-arrow {
  font-size: 38rpx;
  color: #e5bad3;
}
