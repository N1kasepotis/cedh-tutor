@import '../../styles.wxss';
.agreement-line {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--cedh-line);
}
.agreement-line .label {
  margin: 0 0 12rpx;
  color: var(--cedh-text-soft);
}
.agreement-value {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  padding: 20rpx 24rpx;
  min-height: 88rpx;
  min-height: max(44px, 88rpx);
  display: flex;
  align-items: center;
  background: var(--cedh-input-glass);
  border: 1rpx solid var(--cedh-accent-line);
  border-radius: 12rpx;
}
.studio button.saved-table:not([size='mini']) {
  width: 100%;
  margin-top: 12rpx;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  text-align: left;
}
