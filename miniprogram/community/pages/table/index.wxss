@import "../../styles.wxss";
.agreement-line {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.16);
}
.agreement-line .label {
  margin: 0 0 12rpx;
}
.agreement-value {
  font-size: 34rpx;
  line-height: 1.5;
  padding: 8rpx 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.studio button.saved-table {
  width: 100%;
  margin-top: 12rpx;
  justify-content: flex-start;
  text-align: left;
}
