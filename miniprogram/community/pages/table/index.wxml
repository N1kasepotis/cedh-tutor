<view class="studio">
  <text class="eyebrow">EDH 牌桌</text>
  <text class="title">对局约定</text>
  <view class="subtitle">开局前确认强度、代牌与组合技</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{fields}}" wx:key="key" class="agreement-line">
    <view class="grow">
      <text class="label">{{item.label}}</text>
      <picker
        range="{{item.options}}"
        value="{{values[item.key]}}"
        data-key="{{item.key}}"
        bindchange="change"
        disabled="{{incoming || busy}}"
      >
        <view class="agreement-value">
          {{item.options[values[item.key]]}} {{incoming ? '' : '▾'}}
        </view>
      </picker>
    </view>
  </view>
  <view class="notice">请按实际套牌情况商量后选择</view>
  <view wx:if="{{!incoming}}" class="actions">
    <button hover-class="pressable-active" bindtap="save" disabled="{{busy}}">
      保存本桌
    </button>
    <button
      hover-class="pressable-active"
      class="primary"
      bindtap="publish"
      disabled="{{busy}}"
      loading="{{busy}}"
    >
      {{remote ? '更新约定' : '发布约定'}}
    </button>
  </view>
  <view wx:if="{{remote && !dirty}}" class="panel">
    <view class="section-title">开局确认</view>
    <view class="muted">
      {{agreement ? agreement.count + ' 位玩家已确认' : '刷新查看确认人数'}}
    </view>
    <view class="actions">
      <button
        hover-class="pressable-active"
        class="primary"
        bindtap="agree"
        disabled="{{busy}}"
      >
        {{agreement.agreed ? '撤回我的确认' : '确认本桌约定'}}
      </button>
      <button hover-class="pressable-active" open-type="share">发给牌友</button>
    </view>
    <button
      hover-class="pressable-active"
      class="link"
      bindtap="refresh"
      disabled="{{busy}}"
    >
      刷新确认状态
    </button>
  </view>
  <view wx:if="{{dirty && remote}}" class="notice">
    约定已修改，更新分享后，所有玩家需要重新确认
  </view>
  <view class="actions">
    <button hover-class="pressable-active" bindtap="copy">复制约定</button>
    <button hover-class="pressable-active" bindtap="newTable" disabled="{{busy}}">
      再开一桌
    </button>
  </view>
  <button
    hover-class="pressable-active"
    wx:if="{{remote && !incoming && !remote.revoked}}"
    class="link"
    bindtap="revoke"
    disabled="{{busy}}"
  >
    撤回公开约定
  </button>
  <view wx:if="{{!incoming && history.length}}" class="section">
    <view class="section-title">已存约定</view>
    <button
      hover-class="pressable-active"
      wx:for="{{history}}"
      wx:key="id"
      class="saved-table"
      data-id="{{item.id}}"
      bindtap="loadSaved"
      disabled="{{busy}}"
    >
      <text>{{fields[0].options[item.values.level]}}</text>
      <text class="muted">{{item.date}}</text>
    </button>
  </view>
</view>
