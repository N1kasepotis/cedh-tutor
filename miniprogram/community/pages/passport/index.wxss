@import "../../styles.wxss";
.friend-gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin: 28rpx 0;
}
.studio button.gallery-card:not([size="mini"]) {
  display: block;
  padding: 0;
  border: 0;
  background: transparent;
}
.gallery-image {
  width: 100%;
  height: 290rpx;
  display: block;
}
.portrait-slot {
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  padding-top: 28rpx;
  margin-top: 30rpx;
}
.slot-body {
  align-items: center;
  margin: 20rpx 0;
  gap: 28rpx;
}
.slot-image {
  width: 208rpx;
  height: 290rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #211a20;
}
.portrait-slot .section-title {
  margin: 0;
}
.comparison-row {
  align-items: flex-start;
  margin-top: 18rpx;
}
.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 750px;
  height: 1200px;
  pointer-events: none;
}
.poster-preview {
  width: 100%;
  display: block;
  margin: 24rpx 0;
}
