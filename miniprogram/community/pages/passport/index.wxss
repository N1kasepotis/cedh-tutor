@import '../../styles.wxss';
.friend-gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin: 28rpx 0;
}
.studio button.gallery-card:not([size='mini']) {
  display: block;
  padding: 0;
  border: 0;
  background: transparent;
}
.gallery-image {
  width: 100%;
  height: 290rpx;
  display: block;
}
.portrait-slot {
  border-top: 1rpx solid var(--cedh-line);
  padding-top: 28rpx;
  margin-top: 30rpx;
}
.slot-body {
  align-items: center;
  margin: 20rpx 0;
  gap: 28rpx;
}
.slot-image {
  width: 208rpx;
  height: 290rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: var(--cedh-surface);
}
.portrait-slot .section-title {
  margin: 0;
}
.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 900px;
  height: 1440px;
  pointer-events: none;
}
.poster-preview {
  width: 100%;
  display: block;
  margin: 24rpx 0;
}

.portrait-slot {
  padding: 28rpx;
  border: 1rpx solid var(--cedh-line);
  border-radius: 18rpx;
  background: var(--cedh-surface);
}
.slot-hint {
  font-size: 25rpx;
  color: var(--cedh-text-soft);
  margin-top: 12rpx;
}
.studio button.slot-empty:not([size='mini']) {
  width: 174rpx;
  height: 244rpx;
  flex: 0 0 174rpx;
  border: 1rpx dashed var(--cedh-accent-line);
  background: var(--cedh-image-placeholder);
  flex-direction: column;
  gap: 18rpx;
  font-size: 24rpx;
  color: var(--cedh-accent-ink);
  padding: 12rpx;
}
.slot-plus {
  font-size: 44rpx;
  font-weight: 400;
}
.slot-image {
  width: 174rpx;
  height: 244rpx;
}
.slot-body {
  gap: 22rpx;
}
.portrait-slot input {
  margin-bottom: 0;
  background: var(--cedh-input-glass);
}
.portrait-slot .section-title {
  font-size: 34rpx;
}
@media (max-width: 350px) {
  .portrait-slot {
    padding: 22rpx;
  }
  .slot-image {
    width: 148rpx;
    height: 208rpx;
  }
  .studio button.slot-empty:not([size='mini']) {
    flex-basis: 148rpx;
    width: 148rpx;
    height: 208rpx;
  }
}

.slot-hint {
  font-size: 13px;
}

/* 名片图片的两种样式挂在标题同一行，做成两个文字选项，不再单独占一行开关 */
.poster-title {
  margin-bottom: 0;
}
.mode-toggle {
  display: flex;
  flex-shrink: 0;
}
.mode-option {
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  font-size: 14px;
  color: var(--cedh-text-soft);
}
.mode-option.mode-on {
  color: var(--cedh-accent-ink);
  font-weight: 600;
}
