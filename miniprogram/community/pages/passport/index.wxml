<view class="studio">
  <particle-background palette="tracker"></particle-background>
  <view class="content-layer">
    <text class="eyebrow">EDH hub</text>
    <text class="title">三张牌认识你</text>
    <view wx:if="{{friend}}" class="section">
      <view class="section-title">{{friend.content.nickname ? friend.content.nickname + ' 的三张牌' : '牌友的三张牌'}}</view>
      <view class="friend-gallery">
        <button
          hover-class="pressable-active"
          wx:for="{{labels}}"
          wx:key="*this"
          class="gallery-card"
          data-index="{{index}}"
          data-friend="true"
          bindtap="viewCard"
          aria-label="查看 {{item}}：{{friend.content.slots[index].displayName}}"
        >
          <image
            lazy-load
            class="gallery-image"
            src="{{friend.content.slots[index].image}}"
            mode="aspectFit"
          />
          <text class="muted">{{item}}</text>
        </button>
      </view>
      <view wx:for="{{labels}}" wx:key="*this" class="list-item">
        <view class="muted">{{item}}</view>
        <view class="card-name">{{friend.content.slots[index].displayName}}</view>
        <view wx:if="{{friend.content.slots[index].reason}}" class="subtitle">{{friend.content.slots[index].reason}}</view>
      </view>
      <view class="rule" />
    </view>
    <label class="label" for="nickname">署名</label>
    <input
      id="nickname"
      placeholder="牌桌上大家怎么叫你，不填也行"
      value="{{nickname}}"
      bindinput="nickname"
      bindblur="persist"
      maxlength="20"
      disabled="{{busy}}"
    />
    <view wx:for="{{labels}}" wx:key="*this" class="portrait-slot surface">
      <view class="row">
        <view class="section-title">{{item}}</view>
      </view>
      <view class="slot-hint">{{hints[index]}}</view>
      <view class="row slot-body">
        <image
          lazy-load
          wx:if="{{slots[index].image}}"
          class="slot-image"
          src="{{slots[index].image}}"
          mode="aspectFit"
          data-index="{{index}}"
          bindtap="viewCard"
          binderror="imageFailed"
          aria-label="查看 {{slots[index].displayName}}"
        />
        <button
          hover-class="pressable-active"
          wx:else
          class="slot-empty"
          data-index="{{index}}"
          bindtap="choose"
          disabled="{{busy}}"
          aria-label="为{{item}}选牌"
        >
          <text class="slot-plus">＋</text>
          <text>选一张牌</text>
        </button>
        <view class="grow">
          <view class="card-name">{{slots[index].displayName || '还没选'}}</view>
          <view wx:if="{{slots[index]}}" class="muted">
            {{slots[index].lang}} / {{slots[index].set}} #{{slots[index].number}}
          </view>
          <button
            hover-class="pressable-active"
            class="link"
            data-index="{{index}}"
            bindtap="choose"
            disabled="{{busy}}"
          >
            {{slots[index] ? '换一张 / 换版本' : '搜索牌名'}}
          </button>
        </view>
      </view>
      <input
        placeholder="{{reasonHints[index]}}"
        aria-label="{{item}}的短评"
        maxlength="40"
        value="{{reasons[index]}}"
        data-index="{{index}}"
        bindinput="reason"
        bindblur="persist"
        disabled="{{busy}}"
      />
    </view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view class="actions">
      <button
        hover-class="pressable-active"
        wx:if="{{!shareReady}}"
        class="primary"
        bindtap="publish"
        loading="{{busy && task === 'share'}}"
        disabled="{{busy}}"
      >
        生成分享名片
      </button>
      <button hover-class="pressable-active" wx:else class="primary" open-type="share">
        分享给牌友
      </button>
    </view>
    <view class="section">
      <view class="row between">
        <text class="section-title poster-title">名片图片</text>
        <view class="mode-toggle">
          <view
            class="mode-option {{artOnly ? '' : 'mode-on'}}"
            hover-class="pressable-active"
            aria-role="button"
            aria-label="{{artOnly ? '名片图片改用完整卡牌' : '名片图片用完整卡牌，已选'}}"
            data-art="{{false}}"
            bindtap="mode"
          >完整卡牌</view>
          <view
            class="mode-option {{artOnly ? 'mode-on' : ''}}"
            hover-class="pressable-active"
            aria-role="button"
            aria-label="{{artOnly ? '名片图片只看卡画，已选' : '名片图片改为只看卡画'}}"
            data-art="{{true}}"
            bindtap="mode"
          >只看卡画</view>
        </view>
      </view>
      <image
        lazy-load
        wx:if="{{posterPath}}"
        class="poster-preview"
        src="{{posterPath}}"
        mode="widthFix"
        bindtap="previewPoster"
      />
      <view class="actions">
        <button
          hover-class="pressable-active"
          wx:if="{{!posterPath}}"
          bindtap="generatePoster"
          loading="{{busy && task === 'poster'}}"
          disabled="{{busy}}"
        >
          生成名片图片
        </button>
        <button hover-class="pressable-active" wx:else bindtap="saveImage" disabled="{{busy}}">
          保存到相册
        </button>
      </view>
    </view>
    <button
      hover-class="pressable-active"
      wx:if="{{remote.active}}"
      class="link quiet-link"
      bindtap="revoke"
      disabled="{{busy}}"
    >
      撤回分享链接
    </button>
    <canvas id="passport-poster" type="2d" class="poster-canvas" />
    <view class="credit">
      <view>卡图来自 Scryfall，版权归 Wizards of the Coast 与画师所有</view>
    </view>
    <card-picker
      id="passport-picker"
      context="{{'slot-' + slotIndex}}"
      visible="{{picker}}"
      bindselect="selected"
      bindclose="closePicker"
    />
    <view wx:if="{{detail}}" class="modal-mask" catchtap="closeDetail">
      <scroll-view scroll-y class="modal-sheet" catchtap="noop">
        <button hover-class="pressable-active" bindtap="closeDetail">关闭卡牌</button>
        <image lazy-load class="image-card" src="{{detail.image}}" mode="aspectFit" />
        <image
          lazy-load
          wx:if="{{detail.back}}"
          class="image-card"
          src="{{detail.back}}"
          mode="aspectFit"
        />
        <view class="section-title">{{detail.displayName}}</view>
        <text class="subtitle">{{detail.rules}}</text>
      </scroll-view>
    </view>
    <view wx:if="{{privacy}}" class="modal-mask">
      <view class="modal-sheet">
        <view class="section-title">保存名片图片</view>
        <view class="subtitle">保存这张名片需要相册权限</view>
        <button hover-class="pressable-active" class="link" bindtap="privacyContract">
          查看隐私保护指引
        </button>
        <view class="actions">
          <button hover-class="pressable-active" bindtap="declinePrivacy">暂不保存</button>
          <button
            hover-class="pressable-active"
            id="album-privacy-agree"
            class="primary"
            open-type="agreePrivacyAuthorization"
            bindagreeprivacyauthorization="agreePrivacy"
          >
            同意并保存
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
