<view class="studio">
  <text class="eyebrow">EDH 牌桌</text>
  <text class="title">这手留不留</text>
  <view class="subtitle">看起手与座次，选留牌还是调度</view>
  <picker range="{{questions}}" range-key="title" value="{{index}}" bindchange="select">
    <view class="panel row between">
      <text>{{index + 1}} / {{questions.length}}　{{hand.title}}</text>
      <text>▾</text>
    </view>
  </picker>
  <view class="section-title section">{{hand.commander}}</view>
  <text class="subtitle hand-context">{{hand.context}}</text>
  <view class="hand-list">
    <view wx:for="{{hand.cards}}" wx:key="*this" class="hand-card">
      <text class="card-name">{{item}}</text>
    </view>
  </view>
  <community-poll
    poll-id="{{'hand:' + hand.id}}"
    choices="{{choices}}"
    bindanswer="reveal"
  />
  <button
    hover-class="pressable-active"
    wx:if="{{!revealed}}"
    class="link"
    bindtap="reveal"
  >
    查看留牌与调度思路
  </button>
  <view wx:if="{{revealed}}" class="section">
    <view class="panel">
      <view class="section-title">留牌思路</view>
      <view class="subtitle">{{hand.keep}}</view>
    </view>
    <view class="panel">
      <view class="section-title">调度思路</view>
      <view class="subtitle">{{hand.mull}}</view>
    </view>
    <view class="notice">讨论按题目条件展开，实际选择还取决于套牌构成与对手</view>
  </view>
  <view class="actions">
    <button hover-class="pressable-active" bindtap="practice">用我的套牌练习</button>
    <button hover-class="pressable-active" open-type="share">发给牌友</button>
  </view>
</view>
