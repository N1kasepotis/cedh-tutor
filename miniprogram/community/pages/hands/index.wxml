<view class="studio">
  <particle-background palette="tracker"></particle-background>
  <view class="content-layer">
    <text class="eyebrow">EDH 牌桌</text>
    <text class="title">这手留不留</text>
    <view class="subtitle">社区公开讨论过的起手，先投票，再看来源判断</view>
    <picker range="{{labels}}" value="{{index}}" bindchange="select">
      <view class="panel surface row between">
        <text>{{labels[index]}}</text>
        <text>▾</text>
      </view>
    </picker>
    <view class="section-title section">{{hand.commander}}</view>
    <view class="subtitle hand-context">
      <view>4 人 cEDH，{{hand.seat}} 号位</view>
      <view>{{hand.stage}}</view>
      <view>{{hand.table}}</view>
    </view>
    <view class="hand-list">
      <view wx:for="{{hand.cards}}" wx:key="*this" class="hand-card surface">
        <text class="card-name">{{item}}</text>
      </view>
    </view>
    <community-poll
      poll-id="{{'hand:' + hand.id}}"
      choices="{{choices}}"
      bindanswer="reveal"
    />
    <button
      hover-class="pressable-active"
      wx:if="{{!revealed}}"
      class="link"
      bindtap="reveal"
    >
      查看来源判断
    </button>
    <view wx:if="{{revealed}}" class="panel surface">
      <view class="row between">
        <text class="section-title verdict-title">来源判断</text>
        <text class="badge">{{hand.verdict === 'keep' ? '留' : '调度'}}</text>
      </view>
      <view wx:for="{{hand.reasons}}" wx:key="*this" class="subtitle hand-reason">{{item}}</view>
      <view class="muted hand-source">{{source.name}}{{source.published ? '，' + source.published : ''}}</view>
      <view class="muted">{{source.title}}</view>
      <button hover-class="pressable-active" class="link" bindtap="copySource">
        复制来源链接
      </button>
    </view>
    <view class="actions">
      <button hover-class="pressable-active" bindtap="practice">用我的套牌练习</button>
      <button hover-class="pressable-active" open-type="share">发给牌友</button>
    </view>
  </view>
</view>
