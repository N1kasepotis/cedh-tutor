@import '../../styles.wxss';
.hand-context {
  display: block;
}
/* 七张牌格同宽同高：牌名折行时整组一起变高，不让某一张显得更重要 */
.hand-list {
  margin: 30rpx 0 40rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: 12rpx;
}
.hand-card {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border: 1rpx solid var(--cedh-line);
  border-left: 4rpx solid var(--cedh-accent);
  border-radius: 8rpx;
  background: var(--cedh-surface);
  padding: 20rpx;
}
.hand-card .card-name {
  font-size: 27rpx;
}
.verdict-title {
  margin-bottom: 0;
}
.hand-reason {
  margin-top: 16rpx;
}
.hand-source {
  margin-top: 28rpx;
}

.hand-card .card-name {
  font-size: 14px;
}
