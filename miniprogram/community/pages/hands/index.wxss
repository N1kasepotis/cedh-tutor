@import '../../styles.wxss';
.hand-context {
  display: block;
}
.hand-list {
  margin: 30rpx 0 40rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.hand-card {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border: 1rpx solid var(--cedh-line);
  border-left: 4rpx solid var(--cedh-accent);
  border-radius: 8rpx;
  background: var(--cedh-surface);
  padding: 20rpx;
}
.hand-card .card-name {
  font-size: 27rpx;
}
.hand-card:last-child {
  grid-column: 1 / -1;
}
.verdict-title {
  margin-bottom: 0;
}
.hand-reason {
  margin-top: 16rpx;
}
.hand-source {
  margin-top: 28rpx;
}

.hand-card .card-name {
  font-size: 14px;
}
